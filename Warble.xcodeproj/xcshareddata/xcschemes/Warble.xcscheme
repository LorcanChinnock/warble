            <ActionContent
               title = "Quit every other WarbleDev and the installed Warble"
               scriptText = "# Only one WarbleDev runs at a time, and the installed release draws in the notch too. scripts/dev.sh stop reopens it.&#10;&quot;$SRCROOT/scripts/dev.sh&quot; prepare&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "0E5C59994BDE47819764A575"
               BuildableName = "WarbleDev.app"
               BlueprintName = "Warble"
               ReferencedContainer = "container:Warble.xcodeproj">
            </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "0E5C59994BDE47819764A575"
               BuildableName = "WarbleDev.app"
               BlueprintName = "Warble"
               ReferencedContainer = "container:Warble.xcodeproj">
            </BuildableReference>
      </BuildableProductRunnable>
      <CommandLineArguments>
         <CommandLineArgument
            argument = "-notchPreviewState resting"
            isEnabled = "NO">
         </CommandLineArgument>
         <CommandLineArgument
            argument = "-notchPreviewVirtual YES"
            isEnabled = "NO">
         </CommandLineArgument>
         <CommandLineArgument
            argument = "-notchPreviewHousing pill"
            isEnabled = "NO">
         </CommandLineArgument>
         <CommandLineArgument
            argument = "-AppleLanguages (de)"
            isEnabled = "NO">
         </CommandLineArgument>
      </CommandLineArguments>
