---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** Links to every page of a multi-page document, such as the guide, shown in the sidebar under their group's name
   * when they have one. */
  pages?: { href: string; title: string; current?: boolean; group?: string }[];
}
const { title, description, image, imageAlt, headings = [], pages = [] } = Astro.props;
const pageGroups = [...new Set(pages.map((p) => p.group))].map((group) => ({ group, links: pages.filter((p) => p.group === group) }));
const toc = headings.filter((h) => h.depth === 2);
const side = pages.length > 0 || Astro.slots.has('side');
---

<Base title={title} description={description} image={image} imageAlt={imageAlt}>
  <div id="top" class={`wrap doc ${side ? 'with-side' : ''} ${toc.length > 0 ? 'with-toc' : ''}`}>
    {side && (
      <aside class="side">
        <slot name="side" />
        {pages.length > 0 && (
          <nav class="pages" aria-label="Guide pages">
            <details>
              <summary>Guide pages</summary>
              {pageGroups.map(({ group, links }) => (
                <div class="group">
                  {group && <p class="group-name">{group}</p>}
                  <ul>{links.map((p) => <li><a href={p.href} aria-current={p.current ? 'page' : undefined}>{p.title}</a></li>)}</ul>
                </div>
              ))}
            </details>
          </nav>
        )}
      </aside>
    )}
    {toc.length > 0 && (
      <aside class="aside-toc">
        <nav class="on-page" aria-label="On this page">
          <details>
            <summary>On this page</summary>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </details>
        </nav>
      </aside>
    )}
    <article class="prose">
      <slot />
    </article>
  </div>
  {toc.length > 0 && <a class="to-top button small quiet" href="#top" hidden>↑ Back to top</a>}
</Base>

<style>
  .doc { display: grid; gap: 20px; padding-block: 24px 24px; }
  .doc:not(.with-side):not(.with-toc) { max-width: 820px; }
  .side, .aside-toc { display: grid; gap: 16px; align-content: start; min-width: 0; }
  article { min-width: 0; }

  /* Wide: the pages on the left, the article, then what's on this page on the right. */
  @media (min-width: 1000px) {
    .doc.with-side { grid-template-columns: 250px minmax(0, 1fr); gap: 0 48px; align-items: start; }
    .doc.with-side.with-toc { grid-template-columns: 250px minmax(0, 1fr) 210px; }
    .side { grid-column: 1; grid-row: 1; position: sticky; top: 24px; max-height: calc(100dvh - 48px); overflow-y: auto; padding: 4px; margin: -4px; }
    .aside-toc { grid-column: 3; grid-row: 1; position: sticky; top: 24px; }
    .doc:not(.with-side) .aside-toc { grid-column: 2; }
    article { grid-column: 2; grid-row: 1; }
    /* The group names already say these are the guide's pages, and the list is always open. */
    summary { display: none; }
  }
  @media (min-width: 1000px) and (max-width: 1199px) {
    .doc.with-side.with-toc { grid-template-columns: 230px minmax(0, 1fr); }
    .aside-toc { display: none; }
  }

  summary { list-style: none; cursor: pointer; padding: 11px 18px; font-weight: 700; font-size: 15px; background: var(--surface); border-radius: 999px; box-shadow: var(--lift); }
  summary::-webkit-details-marker { display: none; }
  details[open] summary { margin-bottom: 10px; }

  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .pages a, .on-page a { display: block; text-decoration: none; font-weight: 600; font-size: 16px; color: var(--secondary); transition: background 150ms, color 150ms; }
  .pages a { padding: 9px 14px; border-radius: 14px; }
  .pages a:hover { background: var(--fill); color: var(--fg); }
  .pages a[aria-current] { background: var(--yellow); color: var(--on-accent); font-weight: 800; box-shadow: 0 3px 0 var(--yellow-deep); }
  .group + .group { margin-top: 18px; }
  .group-name { margin: 0 0 6px 14px; font: 800 12px/1.4 var(--font); letter-spacing: 0.1em; text-transform: uppercase; color: var(--secondary); }

  .on-page a { padding: 6px 0 6px 14px; border-left: 2px solid var(--hairline); font-size: 15px; font-weight: 600; }
  .on-page a:hover { color: var(--fg); border-left-color: var(--fg); }
  .on-page a[aria-current] { color: var(--fg); font-weight: 800; border-left-color: var(--fg); }
  @media (min-width: 1000px) {
    .on-page summary { display: block; padding: 0; margin: 0 0 12px; background: none; box-shadow: none; font: 800 12px/1.4 var(--font); letter-spacing: 0.1em; text-transform: uppercase; color: var(--secondary); cursor: default; pointer-events: none; }
  }

  @media (max-width: 999px) {
    .pages ul, .on-page ul { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
    .on-page a { border-left: 0; padding-left: 14px; }
  }

  .to-top { position: fixed; right: 16px; bottom: 16px; z-index: 10; }
  .to-top[hidden] { display: none; }
</style>

<script>
  // Mark the section being read in "On this page", and offer a way back up once the title has scrolled away.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.on-page a')].map((a) => [a.hash.slice(1), a]));
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')].filter((h) => links.has(h.id));
  const title = document.querySelector('.prose h1');
  const toTop = document.querySelector<HTMLElement>('.to-top');

  // The current section is the last one whose heading has passed the top third of the window.
  const mark = () => {
    const line = innerHeight * 0.34;
    const current = headings.findLast((h) => h.getBoundingClientRect().top <= line);
    for (const [id, a] of links) {
      if (id === current?.id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  // The observed area runs from far above the window down to that line, so every heading that crosses it fires,
  // even when a single jump (End, Page Down, a dragged scrollbar) carries it past.
  const sections = new IntersectionObserver(mark, { rootMargin: '100000px 0px -66% 0px' });
  headings.forEach((h) => sections.observe(h));

  // The sidebar's lists start collapsed so they don't push the guide down on phones; the wide layout opens them.
  const details = document.querySelectorAll<HTMLDetailsElement>('.side details, .aside-toc details');
  const wide = matchMedia('(min-width: 1000px)');
  const fit = () => details.forEach((d) => (d.open = wide.matches));
  fit();
  wide.addEventListener('change', fit);

  if (title && toTop) {
    new IntersectionObserver(([entry]) => (toTop.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0)).observe(title);
  }
</script>
