---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** Links to every page of a multi-page document, such as the guide, shown in the sidebar above "On this page",
   * under their group's name when they have one. */
  pages?: { href: string; title: string; current?: boolean; group?: string }[];
}
const { title, description, headings = [], pages = [] } = Astro.props;
const pageGroups = [...new Set(pages.map((p) => p.group))].map((group) => ({ group, links: pages.filter((p) => p.group === group) }));
const toc = headings.filter((h) => h.depth === 2);
const side = toc.length > 0 || pages.length > 0 || Astro.slots.has('side');
---

<Base title={title} description={description}>
  <div id="top" class={`wrap doc ${side ? 'with-side' : ''}`}>
    {side && (
      <div class="side">
        <slot name="side" />
        {pages.length > 0 && (
          <nav class="toc pages" aria-label="Guide pages">
            <details>
              <summary>Guide pages</summary>
              {pageGroups.map(({ group, links }) => (
                <div class="group">
                  {group && <p class="group-name">{group}</p>}
                  <ul>{links.map((p) => <li><a href={p.href} aria-current={p.current ? 'page' : undefined}>{p.title}</a></li>)}</ul>
                </div>
              ))}
            </details>
          </nav>
        )}
        {toc.length > 0 && (
          <nav class="toc on-page" aria-label="On this page">
            <details>
              <summary>On this page</summary>
              <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
            </details>
          </nav>
        )}
      </div>
    )}
    <article class="prose">
      <slot />
    </article>
  </div>
  {toc.length > 0 && <a class="to-top button small quiet" href="#top" hidden>↑ Back to top</a>}
</Base>

<style>
  .doc { display: grid; gap: 32px; padding-block: 40px 24px; }
  .doc:not(.with-side) { max-width: 760px; }
  .side { display: grid; gap: 20px; align-content: start; min-width: 0; }
  @media (min-width: 1000px) {
    .doc.with-side { grid-template-columns: 230px minmax(0, 1fr); gap: 56px; align-items: start; }
    /* The sidebar scrolls on its own when it's taller than the window. */
    .side { position: sticky; top: 84px; max-height: calc(100dvh - 100px); overflow-y: auto; padding: 0 10px 8px; margin-inline: -10px; }
    /* The group names already say these are the guide's pages. */
    .pages summary { display: none; }
  }
  @media (max-width: 999px) {
    .toc { padding: 12px 14px; border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--surface); }
  }
  .toc { font-size: 15px; }
  .toc summary { font-weight: 600; cursor: pointer; }
  .toc details[open] summary { margin-bottom: 8px; }
  @media (min-width: 1000px) {
    .toc summary { font-size: 13px; color: var(--secondary); list-style: none; }
    .toc summary::-webkit-details-marker { display: none; }
  }
  .toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  @media (max-width: 999px) { .toc ul { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); } }
  .toc a { display: block; padding: 4px 10px; margin-inline: -10px; border-radius: 8px; text-decoration: none; color: var(--secondary); }
  .toc a:hover { color: var(--fg); background: var(--fill); }
  .toc a[aria-current] { color: var(--fg); background: var(--fill-strong); font-weight: 600; }
  .group + .group { margin-top: 14px; }
  .group-name { margin: 0 0 4px; font: 600 12px/1.4 var(--font); letter-spacing: 0.04em; text-transform: uppercase; color: var(--secondary); }
  .to-top { position: fixed; right: 16px; bottom: 16px; z-index: 10; background: var(--surface); }
  .to-top[hidden] { display: none; }
  article { min-width: 0; }
</style>

<script>
  // Mark the section being read in "On this page", and offer a way back up once the title has scrolled away.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.on-page a')].map((a) => [a.hash.slice(1), a]));
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')].filter((h) => links.has(h.id));
  const title = document.querySelector('.prose h1');
  const toTop = document.querySelector<HTMLElement>('.to-top');

  // The current section is the last one whose heading has passed the top third of the window.
  const mark = () => {
    const line = innerHeight * 0.34;
    const current = headings.findLast((h) => h.getBoundingClientRect().top <= line);
    for (const [id, a] of links) {
      if (id === current?.id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  // The observed area runs from far above the window down to that line, so every heading that crosses it fires,
  // even when a single jump (End, Page Down, a dragged scrollbar) carries it past.
  const sections = new IntersectionObserver(mark, { rootMargin: '100000px 0px -66% 0px' });
  headings.forEach((h) => sections.observe(h));

  // The sidebar's lists start collapsed so they don't push the guide down on phones; the wide layout opens them.
  const details = document.querySelectorAll<HTMLDetailsElement>('.toc details');
  const wide = matchMedia('(min-width: 1000px)');
  const fit = () => details.forEach((d) => (d.open = wide.matches));
  fit();
  wide.addEventListener('change', fit);

  if (title && toTop) {
    new IntersectionObserver(([entry]) => (toTop.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0)).observe(title);
  }
</script>
