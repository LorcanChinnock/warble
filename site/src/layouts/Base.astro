---
import '../styles/global.css';
import { latestRelease } from '../lib/release';

interface Props {
  title?: string;
  description?: string;
  /** A card for this page's link previews, as a path under /; every page without one shares /og.png. */
  image?: string;
  imageAlt?: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = 'Music and media controls in your Mac\'s notch. Free and open source.',
  image = '/og.png',
  imageAlt = 'Your music, in the notch. Warble\'s open notch shows A Moment Apart by ODESZA. Free and open source, for Mac.',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Warble` : 'Warble for Mac: your music, in the notch';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const release = await latestRelease();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return path === target || (target === '/docs/get-started' && path.startsWith('/docs')) ? 'page' : undefined;
};
const nav = [
  { label: 'Features', href: '/#features' },
  { label: 'Guide', href: '/docs/get-started/' },
  { label: 'Changelog', href: '/changelog/' },
  { label: 'GitHub', href: 'https://github.com/LorcanChinnock/warble' },
];
const footer: { title: string; links: [string, string][] }[] = [
  { title: 'Product', links: [['Features', '/#features'], ['Install', '/#install'], ['Other notch apps', '/notch-apps/']] },
  {
    title: 'Help',
    links: [
      ['Guide', '/docs/get-started/'],
      ['When nothing shows', '/docs/when-nothing-shows/'],
      ['Remove Warble', '/docs/remove-warble/'],
      ['Report a bug', 'https://github.com/LorcanChinnock/warble/issues'],
    ],
  },
  {
    title: 'Project',
    links: [
      ['Changelog', '/changelog/'],
      ['GitHub', 'https://github.com/LorcanChinnock/warble'],
      ['Privacy', '/privacy/'],
      ['Sponsor', '/sponsor'],
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbf4e4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1611" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Warble" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title="Warble releases" href="/changelog/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="bar wrap">
        <a class="brand" href="/" aria-label="Warble home">
          <img src="/icon-256.png" alt="" width="34" height="34" />
          <span>Warble</span>
          <span class="beta">Beta</span>
        </a>
        <nav class="links" aria-label="Main">
          {nav.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
        </nav>
        <details class="menu">
          <summary>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            Menu
          </summary>
          <nav aria-label="Pages">
            {nav.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div class="about">
            <a class="brand" href="/">
              <img src="/icon-256.png" alt="" width="28" height="28" loading="lazy" />
              <span>Warble</span>
            </a>
            <p>What's playing, in your Mac's notch. Free and open source under the <a href="https://github.com/LorcanChinnock/warble/blob/main/LICENSE">GPL-3.0 license</a>.</p>
          </div>
          {footer.map((column) => (
            <nav aria-labelledby={`footer-${column.title.toLowerCase()}`}>
              <h2 id={`footer-${column.title.toLowerCase()}`}>{column.title}</h2>
              {column.links.map(([label, href]) => <a href={href}>{label}</a>)}
            </nav>
          ))}
        </div>
        <p class="credit">
          <a class="maker" href="https://lorcanchinnock.com"><span class="lc" aria-hidden="true">LC<span>_</span></span><span class="name">Made by Lorcan Chinnock</span></a>
          <span>Not affiliated with Apple.</span>
        </p>
      </div>
    </footer>
  </body>
</html>
