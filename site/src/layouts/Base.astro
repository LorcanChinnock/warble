---
import '../styles/global.css';
import { latestRelease } from '../lib/release';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Music and media controls in your Mac\'s notch. Free and open source.',
} = Astro.props;
const fullTitle = title ? `${title} · Warble` : 'Warble for Mac: your music, in the notch';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const release = await latestRelease();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbf4e4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1611" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Warble" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Warble's yellow icon beside the words: Your music, in your Mac's notch. Free and open source." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="bar wrap">
        <a class="brand" href="/" aria-label="Warble home">
          <img src="/icon-256.png" alt="" width="38" height="38" />
          <span>Warble</span>
        </a>
        <nav aria-label="Main">
          <a href="/docs/get-started/" aria-current={path.startsWith('/docs') ? 'page' : undefined}>Guide</a>
          <a class="hide-sm" href="/changelog/" aria-current={current('/changelog')}>Changelog</a>
          <a class="hide-sm" href="https://github.com/LorcanChinnock/warble">GitHub</a>
          <a class="hide-sm" href="/sponsor">Sponsor</a>
          <a class="button small" href="/download" title={`Download Warble ${release.version}`}>Download</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="bar wrap">
        <div class="top">
          <a class="brand" href="/">
            <img src="/icon-256.png" alt="" width="38" height="38" loading="lazy" />
            <span>Warble</span>
          </a>
          <nav aria-label="Footer">
            <a href="/docs/get-started/">Guide</a>
            <a href="/changelog/">Changelog</a>
            <a href="/privacy/">Privacy</a>
            <a href="https://github.com/LorcanChinnock/warble">Source</a>
            <a href="https://github.com/LorcanChinnock/warble/issues">Report a bug</a>
            <a href="/sponsor">Sponsor</a>
            <a href="https://github.com/LorcanChinnock/warble/blob/main/LICENSE">GPL-3.0 license</a>
          </nav>
        </div>
        <small>
          <a class="maker" href="https://lorcanchinnock.com"><span class="lc" aria-hidden="true">LC<span>_</span></span><span class="name">Made by Lorcan Chinnock</span></a>
          <span>Not affiliated with Apple.</span>
        </small>
      </div>
    </footer>
  </body>
</html>
