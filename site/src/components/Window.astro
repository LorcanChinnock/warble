---
/** A quiet window frame around a screenshot or loop, with grey title-bar dots rather than the system's colours. */
interface Props {
  title?: string;
  tint?: string;
}
const { title, tint = 'var(--notch)' } = Astro.props;
---

<figure class="window card" style={`--tint: ${tint}`}>
  <div class="titlebar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    {title && <span class="name">{title}</span>}
  </div>
  <div class="pane"><slot /></div>
</figure>

<style>
  .window { margin: 0; padding: 0 6px 6px; overflow: hidden; }
  .titlebar { display: flex; align-items: center; gap: 12px; height: 32px; padding: 0 6px; }
  .lights { display: flex; gap: 7px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: var(--fill-strong); }
  .name { font: 600 13px/1 var(--font); color: var(--secondary); }
  .pane { border-radius: calc(var(--radius) - 6px); overflow: hidden; background: var(--tint); }
  .pane :global(img), .pane :global(video) { width: 100%; border: 0; border-radius: 0; }
</style>
