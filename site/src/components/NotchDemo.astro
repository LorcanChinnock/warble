---
/** A working copy of the notch on a drawing of a Mac's screen, at the top of its container as the real one sits at the top
 * of the display. It matches the app: the housing is 37 points tall with its corners at the app's ratio, resting adds a wing
 * each side for the art and the play-state bars, and the open card is the housing plus 140 points wide and 160 deep, with the
 * app's own rows, sizes and colours (ExpandedContent, Scrubber, PlaybackControls, VolumeSlider). It opens once by itself a
 * moment after it scrolls into view, then waits for a hover. The song and its art are real.
 * Behaviour is in scripts/notch-demo.ts, which ticks only while the card is open on screen. */
const art = '/media/art-moment-apart.webp';
---

<div class="demo" data-notch-demo>
  <div class="bezel">
    <div class="screen">
      <div class="notch" data-state="rest" data-playing="true" tabindex="0" aria-label="Warble's notch. Hover, tap or focus it to open.">
        <div class="glow" aria-hidden="true"></div>
        <div class="layer rest" aria-hidden="true">
          <span class="wing"><img class="small" src={art} alt="" width="25" height="25" /></span>
          <span class="title" data-title>A Moment Apart</span>
          <span class="wing"><span class="bars"><i></i><i></i><i></i><i></i><i></i></span></span>
        </div>
        <div class="layer open" inert>
          <div class="track">
            <img class="big" src={art} alt="" width="56" height="56" />
            <div class="lines"><b data-title>A Moment Apart</b><span data-artist>ODESZA</span><span data-album>A Moment Apart</span></div>
          </div>
          <div class="scrub">
            <span class="time start" data-elapsed>0:18</span>
            <div class="rail" role="slider" tabindex="0" aria-label="Position" aria-valuemin="0" aria-valuenow="18" aria-valuemax="234"><i></i></div>
            <span class="time" data-remaining>-3:35</span>
          </div>
          <div class="controls">
            <button type="button" class="mode shuffle" data-shuffle aria-label="Shuffle" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h3.2c2.2 0 3.3 1.1 4.8 3.4l2.2 3.2c1.5 2.3 2.6 3.4 4.8 3.4H20M3 17h3.2c1.5 0 2.5-.5 3.4-1.6M13.8 8.4c.9-.9 1.9-1.4 3.2-1.4H20M17.5 4l3 3-3 3M17.5 14l3 3-3 3" /></svg></button>
            <button type="button" data-prev aria-label="Previous track"><svg class="side" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13L2.5 12zM21.5 5.5v13L12 12z" /></svg></button>
            <button type="button" data-toggle aria-label="Pause">
              <svg class="pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="5.5" y="4" width="4.5" height="16" rx="1.3" /><rect x="14" y="4" width="4.5" height="16" rx="1.3" /></svg>
              <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" /></svg>
            </button>
            <button type="button" data-next aria-label="Next track"><svg class="side" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13L21.5 12zM2.5 5.5v13L12 12z" /></svg></button>
            <button type="button" class="mode repeat" data-repeat data-mode="off" aria-label="Repeat: off"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 3l3.5 3.5L17 10M4 11V9.5A3 3 0 0 1 7 6.5h13.5M7 21l-3.5-3.5L7 14M20 13v1.5a3 3 0 0 1-3 3H3.5" /><path class="one" d="M11 10.8l1.4-.9v5" /></svg></button>
          </div>
          <div class="volume" data-muted="false">
            <svg class="speaker" viewBox="0 0 24 24" preserveAspectRatio="xMaxYMid meet" aria-hidden="true"><path d="M3 9.5h3.5L12 5v14l-5.5-4.5H3z" /></svg>
            <svg class="speaker muted" viewBox="0 0 24 24" preserveAspectRatio="xMaxYMid meet" aria-hidden="true"><path d="M3 9.5h3.5L12 5v14l-5.5-4.5H3z" /><path class="slash" d="M15 8.5l6 7M21 8.5l-6 7" /></svg>
            <div class="rail" role="slider" tabindex="0" aria-label="Volume" aria-valuemin="0" aria-valuenow="25" aria-valuemax="100"><i></i></div>
            <svg class="output" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet" aria-hidden="true"><circle cx="8" cy="8" r="3.4" /><rect x="6.8" y="9.5" width="2.4" height="8" rx="1.2" /><circle cx="16" cy="8" r="3.4" /><rect x="14.8" y="9.5" width="2.4" height="8" rx="1.2" /></svg>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="caption">
    <span class="pointer">Hover to open it in a split second: the song, progress and controls. Click and it opens at once.</span>
    <span class="finger">Tap the notch to open it: the song, progress and controls. Tap anywhere else to close it.</span>
  </p>
</div>

<style>
  .demo { max-width: 980px; margin-inline: auto; }
  .bezel {
    padding: 10px; border-radius: 34px; background: #2b2118;
    box-shadow: 0 40px 60px -30px rgb(43 33 24 / 0.45), inset 0 2px 0 rgb(255 255 255 / 0.1);
  }
  .screen {
    position: relative; overflow: hidden; border-radius: 26px;
    height: clamp(214px, min(38vw, calc(100svh - 700px)), 430px);
    background: linear-gradient(160deg, #bce0f2 0%, #fde3ee 55%, #ffe9a8 100%);
    color: #2b2118;
  }

  /* The notch, in the app's own proportions (NotchLayout): the housing, then a wing each side, then the open card. */
  .notch {
    --h: 37px; --w: 170px;
    position: absolute; top: 0; left: 50%; translate: -50% 0; z-index: 2;
    width: calc(var(--w) + 2 * var(--h)); max-width: calc(100% - 12px); height: var(--h);
    background: #000; color: #fff; overflow: hidden; text-align: start; cursor: default;
    border-radius: 0 0 calc(var(--h) * 0.32) calc(var(--h) * 0.32);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    transition: width 250ms cubic-bezier(0.3, 0.8, 0.3, 1), height 250ms cubic-bezier(0.3, 0.8, 0.3, 1), border-radius 250ms cubic-bezier(0.3, 0.8, 0.3, 1);
    outline-offset: 0; touch-action: manipulation; -webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none;
    will-change: width, height;
  }
  .notch[data-state='open'] { width: calc(var(--w) + 140px); height: calc(var(--h) + 160px); border-radius: 0 0 24px 24px; }
  .notch:focus-visible { outline: 3px solid #2b2118; outline-offset: 3px; }

  /* The art's two dominant colours glow from the bottom corners of the open card. */
  .glow {
    position: absolute; inset: 0; opacity: 0; transition: opacity 200ms;
    background:
      radial-gradient(ellipse 80% 80% at 0% 100%, rgb(var(--glow-a, 31 111 139) / 0.45), transparent),
      radial-gradient(ellipse 80% 80% at 100% 100%, rgb(var(--glow-b, 20 64 90) / 0.45), transparent);
  }
  .notch[data-state='open'] .glow { opacity: 1; transition-delay: 90ms; }

  .layer { position: absolute; inset: 0; }
  .rest { bottom: auto; height: var(--h); display: grid; grid-template-columns: var(--h) minmax(0, 1fr) var(--h); align-items: center; transition: opacity 120ms; }
  .notch[data-state='open'] .rest { opacity: 0; }
  .wing { display: grid; place-items: center; }
  .small { width: 25px; height: 25px; border-radius: 6px; }
  .title { overflow: hidden; text-align: center; white-space: nowrap; text-overflow: ellipsis; font-size: 13px; font-weight: 500; }
  .bars { display: flex; align-items: center; justify-content: space-between; width: 18px; height: 15px; }
  .bars i { width: 2px; height: calc(var(--bar) * 100%); border-radius: 1px; background: #fff; transition: transform 140ms; }
  .bars i:nth-child(1) { --bar: 0.4; }
  .bars i:nth-child(2) { --bar: 0.85; animation-duration: 0.9s; }
  .bars i:nth-child(3) { --bar: 0.5; animation-duration: 1.3s; }
  .bars i:nth-child(4) { --bar: 1; animation-duration: 1s; }
  .bars i:nth-child(5) { --bar: 0.45; animation-duration: 1.15s; }
  .notch[data-playing='false'] .bars i { animation: none; transform: scaleY(0.14); }

  .open {
    display: flex; flex-direction: column; justify-content: space-between; padding: calc(var(--h) + 6px) 16px 10px;
    opacity: 0; transition: opacity 120ms;
  }
  .notch[data-state='open'] .open { opacity: 1; transition: opacity 200ms 90ms; }
  .track { display: flex; align-items: center; gap: 10px; padding-left: 10px; }
  .big { flex: none; width: 56px; height: 56px; border-radius: 8px; }
  .lines { display: grid; gap: 2px; min-width: 0; }
  .lines b { font-size: 15px; font-weight: 600; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lines span { font-size: 13px; line-height: 1.2; color: #999; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .scrub, .volume { display: flex; align-items: center; gap: 8px; height: 24px; }
  .time { flex: none; min-width: 34px; font-size: 11px; font-variant-numeric: tabular-nums; color: #999; }
  .time.start { text-align: right; }
  .rail { position: relative; flex: 1; height: 4px; border-radius: 2px; background: rgb(255 255 255 / 0.2); cursor: pointer; touch-action: none; }
  .rail::before { content: ''; position: absolute; inset: -10px 0; }
  .rail:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .rail i { position: absolute; inset: 0 auto 0 0; width: calc(var(--played, 0) * (100% - 9px) + 4.5px); border-radius: 2px; background: #fff; }
  .scrub .rail i::after { content: ''; position: absolute; right: -4.5px; top: 50%; width: 9px; height: 9px; margin-top: -4.5px; border-radius: 50%; background: #fff; }

  .controls { position: relative; display: flex; justify-content: center; gap: 12px; }
  .controls button {
    display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 0; border-radius: 8px;
    background: none; color: #fff; cursor: pointer; transition: background 150ms, transform 120ms;
  }
  .controls button:hover { background: rgb(255 255 255 / 0.12); }
  .controls button:active { transform: scale(0.9); }
  .controls button:focus-visible { outline: 2px solid #fff; }
  .controls svg { fill: currentColor; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; }
  .controls .side { width: 16px; height: 16px; }
  .controls .mode { position: absolute; top: 0; color: #999; }
  .controls .mode.shuffle { left: 0; }
  .controls .mode.repeat { right: 0; }
  .controls .mode svg { width: 15px; height: 15px; fill: none; stroke-width: 2; stroke-linecap: round; }
  .controls .mode .one { display: none; stroke-width: 1.8; }
  .controls .mode[data-mode='one'] .one { display: block; }
  .controls .mode[aria-pressed='true'], .controls .mode:not([data-mode='off'])[data-mode] { color: #fff; }
  .controls .mode[aria-pressed='true']::after, .controls .mode[data-mode='all']::after, .controls .mode[data-mode='one']::after { content: ''; position: absolute; bottom: 2px; width: 3px; height: 3px; border-radius: 50%; background: #fff; }
  .controls .pause, .controls .play { width: 22px; height: 22px; }
  .notch[data-playing='true'] .play, .notch[data-playing='false'] .pause { display: none; }

  .volume { color: #999; }
  .speaker { flex: none; width: 34px; height: 13px; fill: currentColor; }
  .speaker.muted { display: none; }
  .speaker .slash { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .volume[data-muted='true'] .speaker { display: none; }
  .volume[data-muted='true'] .speaker.muted { display: block; }
  .output { flex: none; width: 34px; height: 20px; fill: currentColor; }

  .caption { min-height: 3.2em; margin: 22px auto 0; max-width: 620px; text-align: center; font-size: 18px; line-height: 1.45; color: var(--secondary); }

  .finger { display: none; }
  @media (hover: none) {
    .pointer { display: none; }
    .finger { display: inline; }
    .notch { cursor: pointer; }
    .notch:focus-visible { outline: none; }
  }
  @media (max-width: 700px) {
    .bezel { padding: 7px; border-radius: 24px; }
    .screen { border-radius: 18px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .bars i { animation: bars 1.1s ease-in-out infinite alternate; }
    @keyframes bars { from { transform: scaleY(0.45); } to { transform: scaleY(1); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .notch, .open, .rest, .glow { transition: none; }
  }
</style>

<script>
  import '../scripts/notch-demo';
</script>
