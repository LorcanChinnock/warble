---
/** A working copy of the notch on a drawing of a Mac's screen, at the top of its container as the real one sits at the top
 * of the display. It tours the three states by itself (at rest, open with a skip, nothing playing) until the visitor
 * touches it; then hover, the controls and the buttons under it are theirs. The tracks are made up, like the demo player's.
 * Behaviour is in scripts/notch-demo.ts, which runs only while the demo is on screen. */
---

<div class="demo" data-notch-demo>
  <div class="bezel">
    <div class="screen">
      <div class="notch" data-state="rest" data-playing="true" tabindex="0" aria-label="Warble's notch. Hover or focus it to open.">
        <div class="layer rest" aria-hidden="true">
          <span class="art"></span>
          <span class="bars"><i></i><i></i><i></i><i></i></span>
        </div>
        <div class="layer open" inert>
          <div class="track">
            <span class="art big"></span>
            <div class="lines"><b data-title>Static Bloom</b><span data-artist>Halden Rowe</span></div>
            <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          </div>
          <div class="scrub"><span data-elapsed>0:00</span><div class="rail"><i data-progress></i></div><span>3:42</span></div>
          <div class="controls">
            <button type="button" data-prev aria-label="Previous song"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg></button>
            <button type="button" data-toggle aria-label="Pause">
              <svg class="pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
              <svg class="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </button>
            <button type="button" data-next aria-label="Next song"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5l11 7-11 7z" /></svg></button>
          </div>
        </div>
        <div class="layer note" aria-hidden="true">Nothing playing</div>
      </div>
      <p class="hint" data-hint>Hover the notch. It's real!</p>
      <div class="dock" role="group" aria-label="Show a state of the notch">
        <button type="button" data-scene="rest" aria-pressed="true">At rest</button>
        <button type="button" data-scene="open" aria-pressed="false">Open</button>
        <button type="button" data-scene="idle" aria-pressed="false">Nothing playing</button>
      </div>
    </div>
  </div>
  <p class="caption" data-caption>The album art on one side, a few moving bars on the other. That's all you see while you work.</p>
</div>

<style>
  .demo { max-width: 980px; margin-inline: auto; }
  .bezel {
    padding: 10px; border-radius: 34px; background: #2b2118;
    box-shadow: 0 40px 60px -30px rgb(43 33 24 / 0.45), inset 0 2px 0 rgb(255 255 255 / 0.1);
  }
  .screen {
    position: relative; overflow: hidden; border-radius: 26px;
    height: clamp(330px, 38vw, 430px);
    background: linear-gradient(160deg, #bce0f2 0%, #fde3ee 55%, #ffe9a8 100%);
    color: #2b2118;
  }

  /* The notch: black, open from the top edge. Its sizes are the app's proportions at this drawing's scale. */
  .notch {
    position: absolute; top: 0; left: 50%; translate: -50% 0; z-index: 2;
    width: clamp(150px, 22%, 240px); height: 36px;
    background: var(--notch); color: var(--on-notch);
    border-radius: 0 0 14px 14px; overflow: hidden; text-align: start;
    transition: width 600ms cubic-bezier(0.16, 1, 0.3, 1), height 600ms cubic-bezier(0.16, 1, 0.3, 1), border-radius 600ms cubic-bezier(0.16, 1, 0.3, 1);
    outline-offset: 0;
  }
  .notch[data-state='open'] { width: min(440px, calc(100% - 24px)); height: 176px; border-radius: 0 0 24px 24px; }
  .notch[data-state='note'] { width: min(300px, calc(100% - 24px)); height: 70px; border-radius: 0 0 20px 20px; }
  .notch[data-state='idle'] { height: 34px; }
  .notch:focus-visible { outline: 3px solid #2b2118; outline-offset: 3px; border-radius: 0 0 14px 14px; }

  .layer { position: absolute; inset: 0 0 auto; }
  .rest { height: 36px; display: flex; align-items: center; justify-content: space-between; padding-inline: 12px; transition: opacity 250ms; }
  .notch:not([data-state='rest']) .rest { opacity: 0; }
  .open { padding: 40px clamp(14px, 3vw, 22px) 12px; opacity: 0; translate: 0 -8px; pointer-events: none; transition: opacity 300ms, translate 500ms cubic-bezier(0.16, 1, 0.3, 1); }
  .notch[data-state='open'] .open { opacity: 1; translate: 0 0; pointer-events: auto; transition-delay: 100ms; }
  .note { padding-top: 38px; text-align: center; font: 600 15px/1.2 var(--font); color: #cfc9c2; opacity: 0; transition: opacity 300ms; }
  .notch[data-state='note'] .note { opacity: 1; transition-delay: 120ms; }

  .art { display: block; flex: none; width: 22px; height: 22px; border-radius: 6px; background: var(--art, #ff7db4); transition: background 600ms; }
  .art.big { width: 56px; height: 56px; border-radius: 10px; }
  .bars { display: flex; align-items: flex-end; gap: 3px; height: 14px; flex: none; }
  .track .bars { height: 18px; }
  .bars i { width: 3px; height: 100%; border-radius: 2px; background: #fff; transform-origin: bottom; animation: eq 1.1s ease-in-out infinite; }
  .bars i:nth-child(2) { animation-delay: -0.4s; animation-duration: 0.9s; }
  .bars i:nth-child(3) { animation-delay: -0.8s; animation-duration: 1.3s; }
  .bars i:nth-child(4) { animation-delay: -0.2s; animation-duration: 1s; }
  .notch[data-playing='false'] .bars i { animation-play-state: paused; }
  @keyframes eq { 0%, 100% { transform: scaleY(0.25); } 50% { transform: scaleY(1); } }

  .track { display: flex; align-items: center; gap: 14px; }
  .lines { min-width: 0; flex: 1; }
  .lines b { display: block; font: 700 17px/1.25 var(--font); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lines span { display: block; font: 500 14px/1.3 var(--font); color: var(--on-notch-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .scrub { display: flex; align-items: center; gap: 10px; margin-top: 10px; font: 500 11px/1 var(--mono); color: var(--on-notch-secondary); font-variant-numeric: tabular-nums; }
  .rail { flex: 1; height: 4px; border-radius: 2px; background: rgb(255 255 255 / 0.2); overflow: hidden; }
  .rail i { display: block; height: 100%; width: 0; background: #fff; transition: width 200ms linear; }
  .controls { display: flex; justify-content: center; gap: 10px; }
  .controls button {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%;
    background: none; color: #fff; cursor: pointer; transition: background 200ms, transform 150ms;
  }
  .controls button[data-toggle] { background: rgb(255 255 255 / 0.14); }
  .controls button:hover { background: rgb(255 255 255 / 0.2); }
  .controls button:active { transform: scale(0.88); }
  .controls button:focus-visible { outline-color: #fff; }
  .controls svg { width: 22px; height: 22px; fill: currentColor; }
  .notch[data-playing='true'] .play, .notch[data-playing='false'] .pause { display: none; }

  .hint { position: absolute; left: 0; right: 0; top: 190px; margin: 0; text-align: center; font: 700 15px/1.2 var(--font); color: rgb(43 33 24 / 0.7); transition: opacity 400ms; }
  .demo[data-touched] .hint { opacity: 0; }

  /* The three states, as buttons: they follow the tour, and a press takes the demo over. */
  .dock {
    position: absolute; left: 50%; bottom: 18px; translate: -50% 0; display: flex; gap: 4px; padding: 5px; max-width: calc(100% - 20px);
    border-radius: 999px; background: rgb(255 251 242 / 0.72); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px rgb(43 33 24 / 0.08);
  }
  .dock button {
    height: 44px; padding: 0 16px; border: 0; border-radius: 999px; background: none; cursor: pointer; white-space: nowrap;
    font: 700 14px/1 var(--font); color: #6b5b4d; transition: background 200ms, color 200ms;
  }
  .dock button:hover { color: #2b2118; }
  .dock button[aria-pressed='true'] { background: #fff; color: #2b2118; box-shadow: 0 2px 0 rgb(43 33 24 / 0.12), 0 0 0 1px rgb(43 33 24 / 0.06); }
  .dock button:focus-visible { outline-color: #2b2118; }

  .caption { min-height: 3.2em; margin: 22px auto 0; max-width: 620px; text-align: center; font-size: 18px; line-height: 1.45; color: var(--secondary); }

  @media (max-width: 700px) {
    .bezel { padding: 7px; border-radius: 24px; }
    .screen { border-radius: 18px; }
    .dock button { padding: 0 12px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .notch, .open, .rest, .note, .rail i { transition: none; }
    .bars i { animation: none; transform: scaleY(0.6); }
  }
</style>

<script>
  import '../scripts/notch-demo';
</script>
