---
/** A drawing of the top of a Mac's screen with Warble's card open in the notch, at the app's proportions
 * (NotchLayout: a 185 by 32 point housing, 70 points either side and 160 below once open). On load the card grows out
 * of the notch, as it does on a hover; with Reduce Motion it's simply there. */
---

<figure class="screen" role="img" aria-label="Warble open in a Mac's notch, showing the song's art, title and artist, how far through it is, buttons to go back, pause and skip, and the volume.">
  <div class="menubar" aria-hidden="true">
    <span class="items"><i></i><i></i><i></i><i></i></span>
    <span class="items right"><i></i><i></i><i></i></span>
  </div>
  <div class="card-open" aria-hidden="true">
    <div class="content">
      <div class="track">
        <div class="art"></div>
        <div class="lines"><b>Preview track</b><span>Preview artist</span></div>
      </div>
      <div class="scrub"><span>1:12</span><div class="bar"><i></i></div><span>−2:31</span></div>
      <div class="controls">
        <svg viewBox="0 0 32 20"><path d="M15 3v14L4 10zM28 3v14L17 10z" /></svg>
        <svg class="pause" viewBox="0 0 20 22"><rect x="3" y="2" width="5" height="18" rx="1.5" /><rect x="12" y="2" width="5" height="18" rx="1.5" /></svg>
        <svg viewBox="0 0 32 20"><path d="M4 3v14l11-7zM17 3v14l11-7z" /></svg>
      </div>
      <div class="volume">
        <svg viewBox="0 0 20 20"><path d="M3 7h3l5-4v14l-5-4H3z" /></svg>
        <div class="bar"><i></i></div>
        <svg viewBox="0 0 20 20"><rect x="5" y="2" width="10" height="16" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="10" cy="12" r="2.4" /></svg>
      </div>
    </div>
  </div>
</figure>

<style>
  /* --u is one of the app's points, so every size below is the app's own. */
  .screen {
    container-type: inline-size;
    position: relative; margin: 0; width: 100%; max-width: 760px; aspect-ratio: 760 / 380;
    text-align: start;
    background: var(--surface);
    border: 1px solid var(--hairline); border-bottom: 0;
    border-radius: 20px 20px 0 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 78%, transparent);
    mask-image: linear-gradient(#000 78%, transparent);
  }
  .screen > * { --u: min(1.4px, 100cqw / 400); }

  .menubar { position: absolute; inset: 0 0 auto; height: calc(32 * var(--u)); display: flex; align-items: center; justify-content: space-between; padding-inline: calc(14 * var(--u)); }
  .items { display: flex; gap: calc(12 * var(--u)); }
  .items i { width: calc(22 * var(--u)); height: calc(6 * var(--u)); border-radius: 99px; background: var(--fill-strong); }
  .items i:first-child { width: calc(10 * var(--u)); }
  .items.right i:first-child { width: calc(22 * var(--u)); }
  @container (max-width: 520px) { .items i:nth-child(n + 3) { display: none; } }

  .card-open {
    --open: inset(0 0 0 0 round 0 0 calc(24 * var(--u)) calc(24 * var(--u)));
    position: absolute; top: 0; left: 50%; translate: -50% 0;
    width: calc(325 * var(--u)); height: calc(192 * var(--u));
    background: var(--notch); color: var(--on-notch);
    clip-path: var(--open);
    animation: notch-open 520ms cubic-bezier(0.32, 0.72, 0, 1) 300ms backwards;
  }
  /* The glow in the artwork's colours, rising from the bottom corners and gone before the top edge. */
  .card-open::before, .card-open::after {
    content: ""; position: absolute; bottom: -45%; width: 85%; height: 120%; opacity: 0.45;
    animation: notch-fade 400ms ease-in-out 600ms backwards;
  }
  .card-open::before { left: -35%; background: radial-gradient(closest-side, var(--glow-a), transparent); }
  .card-open::after { right: -35%; background: radial-gradient(closest-side, var(--glow-b), transparent); }
  /* The housing at rest: 185 by 32 points with its corners at 0.32 of its height. */
  @keyframes notch-open { from { clip-path: inset(0 calc(70 * var(--u)) calc(160 * var(--u)) round 0 0 calc(10 * var(--u)) calc(10 * var(--u))); } }
  @keyframes notch-fade { from { opacity: 0; } }

  .content {
    position: relative; z-index: 1; height: 100%;
    display: grid; grid-template-rows: auto 1fr auto 1fr auto 1fr auto; align-items: center;
    padding: calc(38 * var(--u)) calc(16 * var(--u)) calc(10 * var(--u));
    animation: notch-fade 250ms ease-in-out 560ms backwards;
  }
  .track { display: flex; align-items: center; gap: calc(12 * var(--u)); }
  .art {
    flex: none; width: calc(56 * var(--u)); height: calc(56 * var(--u)); border-radius: calc(8 * var(--u));
    background: radial-gradient(circle at 30% 30%, #ffd2a8, transparent 45%), linear-gradient(135deg, var(--glow-a), var(--glow-b));
  }
  .lines { display: grid; gap: calc(2 * var(--u)); min-width: 0; }
  .lines b { font: 600 calc(15 * var(--u))/1.2 var(--font); }
  .lines span { font: 400 calc(13 * var(--u))/1.2 var(--font); color: var(--on-notch-secondary); }

  .scrub, .volume { display: flex; align-items: center; gap: calc(8 * var(--u)); grid-row: 3; }
  .volume { grid-row: 7; }
  .scrub span { min-width: calc(34 * var(--u)); font: 400 calc(11 * var(--u))/1 var(--font); font-variant-numeric: tabular-nums; color: var(--on-notch-secondary); }
  .scrub span:last-child { text-align: right; }
  .bar { flex: 1; height: calc(4 * var(--u)); border-radius: 99px; background: rgb(255 255 255 / 0.2); }
  .bar i { display: block; width: 32%; height: 100%; border-radius: inherit; background: var(--on-notch); }
  .volume .bar i { width: 60%; }
  .volume svg { flex: none; width: calc(14 * var(--u)); height: calc(14 * var(--u)); fill: var(--on-notch-secondary); margin-inline: calc(10 * var(--u)); }

  .controls { grid-row: 5; display: flex; justify-content: center; align-items: center; gap: calc(26 * var(--u)); fill: var(--on-notch); }
  .controls svg { width: calc(24 * var(--u)); height: calc(16 * var(--u)); }
  .controls .pause { width: calc(18 * var(--u)); height: calc(22 * var(--u)); }

  @media (prefers-reduced-motion: reduce) {
    .card-open { animation: none; }
  }
</style>
