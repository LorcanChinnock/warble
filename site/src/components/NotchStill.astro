---
/** Warble's notch in one state, drawn still at the app's own sizes (NotchLayout, ExpandedContent), to hang from the top of a
 * ScreenCrop. Resting is the housing plus a wing each side, 244 × 37; open is 310 × 197; the note is 244 × 73; the notch
 * Warble draws on a display without one is 208 × 24 with the title in its middle. Only NotchDemo moves. */
type Track = { title: string; artist: string; album: string; art: string; glow: [string, string] };
interface Props {
  state: 'rest' | 'open' | 'note' | 'drawn';
  track?: Track;
  /** Where the song is, 0 to 1, and the times either side of the bar. */
  played?: number;
  elapsed?: string;
  remaining?: string;
  /** The speaker list open under the card, with the Mac's speakers ticked. */
  speakers?: boolean;
  /** A pointer drawn over the notch, as an offset from the screen's top centre. */
  pointer?: { x: number; y: number };
}
const { state, track, played = 0.1, elapsed = '0:18', remaining = '-3:35', speakers = false, pointer } = Astro.props;
const art = track && `/media/art-${track.art}.webp`;
const glow = track && `--glow-a: ${track.glow[0]}; --glow-b: ${track.glow[1]}`;
---

{state === 'rest' && (
  <div class="notch rest">
    <img src={art} alt="" width="25" height="25" />
    <span class="bars"><i /><i /><i /><i /><i /></span>
  </div>
)}

{state === 'open' && track && (
  <div class="notch open" style={glow}>
    <div class="track">
      <img src={art} alt="" width="56" height="56" />
      <div class="lines"><b>{track.title}</b><span>{track.artist}</span><span>{track.album}</span></div>
    </div>
    <div class="row"><span class="time start">{elapsed}</span><span class="rail"><i style={`width: ${played * 100}%`} /></span><span class="time">{remaining}</span></div>
    <div class="controls">
      <svg class="mode" viewBox="0 0 24 24"><path d="M3 7h3.2c2.2 0 3.3 1.1 4.8 3.4l2.2 3.2c1.5 2.3 2.6 3.4 4.8 3.4H20M3 17h3.2c1.5 0 2.5-.5 3.4-1.6M13.8 8.4c.9-.9 1.9-1.4 3.2-1.4H20M17.5 4l3 3-3 3M17.5 14l3 3-3 3" /></svg>
      <svg class="side" viewBox="0 0 24 24"><path d="M12 5.5v13L2.5 12zM21.5 5.5v13L12 12z" /></svg>
      <svg class="pause" viewBox="0 0 24 24"><rect x="5.5" y="4" width="4.5" height="16" rx="1.3" /><rect x="14" y="4" width="4.5" height="16" rx="1.3" /></svg>
      <svg class="side" viewBox="0 0 24 24"><path d="M12 5.5v13L21.5 12zM2.5 5.5v13L12 12z" /></svg>
      <svg class="mode" viewBox="0 0 24 24"><path d="M17 3l3.5 3.5L17 10M4 11V9.5A3 3 0 0 1 7 6.5h13.5M7 21l-3.5-3.5L7 14M20 13v1.5a3 3 0 0 1-3 3H3.5" /></svg>
    </div>
    <div class="row volume">
      <svg class="speaker" viewBox="0 0 24 24" preserveAspectRatio="xMaxYMid meet"><path d="M3 9.5h3.5L12 5v14l-5.5-4.5H3z" /></svg>
      <span class="rail"><i style="width: 45%" /></span>
      {speakers
        ? <svg class="output laptop" viewBox="0 0 24 24"><path d="M3.5 6.5h17v9h-17zM1.5 17.5h21" /></svg>
        : <svg class="output" viewBox="0 0 24 24"><circle cx="8" cy="8" r="3.4" /><rect x="6.8" y="9.5" width="2.4" height="8" rx="1.2" /><circle cx="16" cy="8" r="3.4" /><rect x="14.8" y="9.5" width="2.4" height="8" rx="1.2" /></svg>}
    </div>
  </div>
)}

{state === 'open' && speakers && (
  <div class="speakers">
    <div><span class="tick">✓</span><svg viewBox="0 0 24 18"><path d="M4 2.5h16v10H4zM1.5 15h21" /></svg>MacBook Pro Speakers</div>
    <div class="highlighted"><span class="tick" /><svg viewBox="0 0 24 18"><path d="M7.5 2.5a3 3 0 1 1 0 6M16.5 2.5a3 3 0 1 0 0 6M7.5 8.5v7M16.5 8.5v7" /></svg>AirPods Pro</div>
  </div>
)}

{state === 'note' && <div class="notch note">Nothing playing</div>}

{state === 'drawn' && track && (
  <div class="notch drawn">
    <img src={art} alt="" width="16" height="16" />
    <span class="title">{track.title}</span>
    <span class="bars"><i /><i /><i /><i /><i /></span>
  </div>
)}

{pointer && (
  <svg class="pointer" style={`left: calc(50% + ${pointer.x}px); top: ${pointer.y}px`} viewBox="0 0 22 26"><path d="M2 1.5v19.2l4.9-4.6 3.2 7.4 3.4-1.5-3.2-7.2h6.8z" /></svg>
)}

<style>
  .notch {
    position: absolute; top: 0; left: 50%; translate: -50% 0; box-sizing: border-box; text-align: start;
    color: #fff; background: #000;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
  }
  img { display: block; }
  svg { display: block; }

  .rest { width: 244px; height: 37px; border-radius: 0 0 12px 12px; display: flex; align-items: center; justify-content: space-between; padding: 0 12px 0 6px; }
  .rest img { width: 25px; height: 25px; border-radius: 6px; }
  .bars { display: flex; align-items: center; justify-content: space-between; width: 18px; height: 15px; }
  .bars i { width: 2px; border-radius: 1px; background: #fff; }
  .bars i:nth-child(1) { height: 40%; }
  .bars i:nth-child(2) { height: 85%; }
  .bars i:nth-child(3) { height: 50%; }
  .bars i:nth-child(4) { height: 100%; }
  .bars i:nth-child(5) { height: 45%; }

  .open {
    width: 310px; height: 197px; border-radius: 0 0 24px 24px; padding: 43px 16px 10px;
    display: flex; flex-direction: column; justify-content: space-between;
    background:
      radial-gradient(ellipse 80% 80% at 0% 100%, rgb(var(--glow-a) / 0.45), transparent),
      radial-gradient(ellipse 80% 80% at 100% 100%, rgb(var(--glow-b) / 0.45), transparent),
      #000;
  }
  .track { display: flex; align-items: center; gap: 12px; }
  .track img { flex: none; width: 56px; height: 56px; border-radius: 8px; }
  .lines { display: grid; gap: 2px; min-width: 0; }
  .lines b { font-size: 16px; font-weight: 600; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lines span { font-size: 13px; line-height: 1.2; color: #999; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row { display: flex; align-items: center; gap: 8px; height: 24px; }
  .time { flex: none; min-width: 34px; font-size: 11px; font-variant-numeric: tabular-nums; color: #999; }
  .time.start { text-align: right; }
  .rail { position: relative; flex: 1; height: 4px; border-radius: 2px; background: rgb(255 255 255 / 0.2); }
  .rail i { position: absolute; inset: 0 auto 0 0; border-radius: 2px; background: #fff; }
  .controls { display: flex; align-items: center; justify-content: space-between; height: 30px; padding: 0 7px; }
  .controls svg { fill: #fff; }
  .controls .mode { width: 15px; height: 15px; fill: none; stroke: #999; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .controls .side { width: 16px; height: 16px; }
  .controls .pause { width: 22px; height: 22px; }
  .volume svg { flex: none; fill: #999; }
  .speaker { width: 34px; height: 13px; }
  .output { width: 34px; height: 20px; }
  .output.laptop { fill: none; stroke: #fff; stroke-width: 1.6; stroke-linejoin: round; }

  .speakers {
    position: absolute; left: calc(50% - 81px); top: 206px; width: 236px; padding: 5px; box-sizing: border-box;
    border-radius: 10px; background: rgb(44 44 46 / 0.97); box-shadow: 0 0 0 0.5px rgb(255 255 255 / 0.16), 0 14px 34px rgb(0 0 0 / 0.38);
    font: 13px/1 -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif; color: #fff; text-align: start;
  }
  .speakers div { display: flex; align-items: center; gap: 7px; height: 24px; padding: 0 8px; border-radius: 5px; }
  .speakers .highlighted { background: #0a64d2; }
  .speakers .tick { width: 12px; text-align: center; }
  .speakers svg { width: 18px; height: 14px; fill: none; stroke: #fff; stroke-width: 1.5; stroke-linejoin: round; }

  .note { width: 244px; height: 73px; border-radius: 0 0 14px 14px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 13px; font-size: 13px; font-weight: 500; color: #8e8e93; }

  .drawn { width: 208px; height: 24px; border-radius: 0 0 8px 8px; display: flex; align-items: center; gap: 6px; padding: 0 6px 0 4px; }
  .drawn img { width: 16px; height: 16px; border-radius: 4px; }
  .drawn .title { flex: 1; min-width: 0; text-align: center; font-size: 11px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .drawn .bars { width: 14px; height: 11px; }

  .pointer { position: absolute; width: 22px; height: 26px; fill: #000; stroke: #fff; stroke-width: 1.6; stroke-linejoin: round; }
</style>
