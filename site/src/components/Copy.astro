---
/** A one-line shell command with a copy button. */
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<div class="copy card">
  <code>{command}</code>
  <button type="button" class="button small quiet" data-copy={command}>Copy</button>
  <span class="status" aria-live="polite"></span>
</div>

<script>
  import '../scripts/copy';
</script>

