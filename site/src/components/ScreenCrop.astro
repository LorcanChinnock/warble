---
/** The top of a Mac's screen, for a notch to hang from: a black bezel, the menu bar and the site's pastel wallpaper, fading
 * into the page below. `external` draws an external display's shorter menu bar, which Warble draws its own notch into.
 * The notch goes in the slot; a crop is a picture, so it takes a `label` for screen readers. */
interface Props {
  label: string;
  /** The screen's height in pixels. */
  height: number;
  /** The app named first in the menu bar. */
  app?: string;
  external?: boolean;
}
const { label, height, app = 'Music', external = false } = Astro.props;
---

<div class:list={['crop', { external }]} role="img" aria-label={label}>
  <div class="glass" style={`height: ${height}px`}>
    <div class="menubar" aria-hidden="true">
      <span class="items"><b>{app}</b><span>File</span><span>Edit</span></span>
      <span>09:41</span>
    </div>
    <slot />
  </div>
</div>

<style>
  .crop {
    background: #0a0a0a; border-radius: 30px 30px 0 0; padding: 11px 11px 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent);
    mask-image: linear-gradient(to bottom, #000 58%, transparent);
  }
  .glass {
    position: relative; overflow: hidden; border-radius: 19px 19px 0 0;
    background: linear-gradient(118deg, var(--sky), color-mix(in srgb, var(--pink) 30%, #fff) 55%, color-mix(in srgb, var(--yellow) 42%, #fff));
  }
  .menubar {
    position: absolute; inset: 0 0 auto; height: 37px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px;
    font: 500 13px/1 -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif; color: rgb(0 0 0 / 0.82); background: rgb(255 255 255 / 0.3);
  }
  .items { display: flex; gap: 18px; }
  .items b { font-weight: 700; }
  .external .menubar { height: 24px; padding: 0 12px; font-size: 12px; }
  /* On a phone the crop is barely wider than the notch, so the menu bar keeps its band and drops its words. */
  @media (max-width: 520px) {
    .menubar > * { visibility: hidden; }
  }
</style>
