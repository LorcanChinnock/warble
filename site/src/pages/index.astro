---
import Copy from '../components/Copy.astro';
import ForMacs from '../components/ForMacs.astro';
import NotchDemo from '../components/NotchDemo.astro';
import Base from '../layouts/Base.astro';
import player from '../../../docs/media/player.png';
import { latestRelease } from '../lib/release';

const release = await latestRelease();
const brew = 'brew install lorcanchinnock/tap/warble';

const points = [
  { key: 'note', title: 'Any player', color: 'pink', text: 'Apple Music, Spotify, podcast apps, and video in Safari, Chrome or any other browser.', icon: ['M9 18V6l10-2v12M6.5 15.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM16.5 13.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z'] },
  { key: 'speaker', title: 'Switch speakers', color: 'sky', text: 'Pick where the sound plays, such as your Mac, headphones or AirPods, from the open notch.', icon: ['M11 5 6 9H3v6h3l5 4z', 'M15.5 8.5a5 5 0 0 1 0 7', 'M18.5 5.5a9 9 0 0 1 0 13'] },
  {
    key: 'clock', title: 'Calm by default', color: 'yellow',
    text: "When nothing's playing, Warble uses no CPU, and pointing at the notch opens a small note that says so. A hover opens the player in a split second, and a click brings up the app that's playing.",
    icon: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z', 'M12 7v5l3 2'],
  },
  { key: 'mac', title: 'Every Mac', color: 'pink', text: 'On a Mac without a notch, or an external display with the menu bar, Warble draws a notch of its own at the top of the screen.', icon: ['M3 5h18v11H3zM8 20h8M12 16v4', 'M9.5 5h5v2.4h-5z'] },
  {
    key: 'lock', title: 'Private', color: 'sky',
    text: "No account, no cloud, no analytics. Warble goes online to check for updates, which it asks about first, and to find the album cover for a song playing in your browser, which sends only its title and artist to Apple's iTunes Search. A click on the artist asks Spotify or YouTube for their page.",
    icon: ['M5 11h14v9H5z', 'M8 11V8a4 4 0 0 1 8 0v3'],
  },
  { key: 'heart', title: 'Free', color: 'yellow', text: 'Free and open source, with no ads.', icon: ['M12 21s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6-8 11-8 11z'], sponsor: true },
];
const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Warble',
  description: "Shows what's playing in your Mac's notch, with play, pause, skip and speaker controls. Free and open source.",
  url: 'https://warble.lorcanchinnock.com/',
  image: 'https://warble.lorcanchinnock.com/icon-256.png',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS 15 or later',
  softwareVersion: release.version,
  downloadUrl: 'https://warble.lorcanchinnock.com/download',
  license: 'https://github.com/LorcanChinnock/warble/blob/main/LICENSE',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Lorcan Chinnock', url: 'https://lorcanchinnock.com' },
  sameAs: ['https://github.com/LorcanChinnock/warble'],
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(software)} />
  <section class="hero">
    <div class="wrap">
      <h1>Your music, in the <span class="squig">notch<svg aria-hidden="true" viewBox="0 0 300 24" preserveAspectRatio="none"><path d="M4 14C40 2 70 22 110 12S190 4 230 14 280 8 296 12" fill="none" stroke="var(--pink)" stroke-width="8" stroke-linecap="round" pathLength="1" /></svg></span>.</h1>
      <p class="lede">Warble shows what's playing in your Mac's notch. Hover over it to see the song, then play, pause, skip or switch speakers. When nothing's playing, it stays out of sight.</p>
      <div class="cta">
        <a class="button big" href="/download">Download for Mac</a>
        <Copy command={brew} />
      </div>
      <ForMacs />
      <p class="meta">Free and open source · Beta {release.version} · macOS 15 or later · Apple silicon and Intel · <a href="#install">How to install</a></p>
    </div>
  </section>

  <section class="screen-section" aria-label="Warble in the notch">
    <div class="wrap"><NotchDemo />
      <noscript><img class="still" src={player.src} width={player.width} height={player.height} alt="Warble's opened notch showing the song Paper Lanterns by Juniper Hale, with the position bar, previous, pause and next buttons and the volume slider." /></noscript>
    </div>
  </section>

  <section class="points" aria-labelledby="points">
    <div class="wrap">
      <h2 id="points" class="visually-hidden">What Warble does</h2>
      <ul class="grid">
        {points.map((point) => (
          <li class={`card point ${point.key}`}>
            <span class={`icon ${point.color}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{point.icon.map((d) => <path d={d} />)}</svg></span>
            <h3>{point.title}</h3>
            <p>{point.text}{point.sponsor && <> The <a href="https://github.com/LorcanChinnock/warble">code is on GitHub</a>. If you like it, you can <a href="/sponsor">sponsor it</a>, which helps pay to have Apple notarize it.</>}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="install-section" id="install" aria-labelledby="install-title">
    <div class="wrap">
      <div class="panel">
        <span class="panel-notch" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <div class="left">
          <h2 id="install-title">Get Warble.</h2>
          <p class="blurb">Install it with Homebrew, or download the zip and drag Warble into Applications.</p>
          <Copy command={brew} />
          <div class="actions">
            <a class="button big dark" href="/download">Download the zip</a>
            <a class="button big quiet" href="https://github.com/LorcanChinnock/warble">GitHub</a>
          </div>
          <ForMacs />
        </div>
        <div class="right">
          <p class="label">The first time you open it</p>
          <p class="gate">Warble isn't notarized by Apple yet, so macOS blocks it the first time you open it:</p>
          <ol class="steps">
            <li><span>Open Warble from Applications. macOS says it can't check Warble. Click <b>Done</b>.</span></li>
            <li><span>Open <b>System Settings</b>, choose <b>Privacy &amp; Security</b> and scroll down to <b>Security</b>.</span></li>
            <li><span>Click <b>Open Anyway</b> next to the message about Warble, then confirm.</span></li>
            <li><span>Play something. The notch slides out to show it.</span></li>
          </ol>
          <p class="beta">Warble is a beta, still being built, so expect changes between versions. The <a href="/docs/get-started/">guide</a> covers the rest.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  section { padding-block: clamp(32px, 5vw, 64px); }
  .hero { padding-top: clamp(16px, 3vw, 40px); padding-bottom: clamp(16px, 2vw, 24px); }
  .hero .wrap { display: grid; justify-items: center; text-align: center; gap: 0; }
  h1 { max-width: 15ch; font-size: clamp(46px, min(9vw, 13vh), 120px); line-height: 0.98; letter-spacing: -0.035em; }
  .squig { position: relative; display: inline-block; }
  .squig svg { position: absolute; left: -2%; bottom: -0.12em; width: 104%; height: 0.2em; overflow: visible; }
  .squig path { stroke-dasharray: 1; stroke-dashoffset: 0; animation: draw 1.2s 0.5s ease-out backwards; }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  .lede { margin: 20px 0 0; max-width: 34em; font-size: clamp(18px, 2vw, 23px); line-height: 1.45; color: var(--secondary); }
  .cta { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; align-items: center; width: 100%; margin-top: 26px; }
  .cta :global(.copy) { flex: 0 1 460px; min-width: 0; text-align: start; }
  .hero :global(.for-macs) { justify-content: center; margin-top: 18px; }
  .meta { margin: 18px 0 0; font-size: 15px; font-weight: 600; color: var(--secondary); max-width: 40em; }
  .meta a { color: var(--fg); }

  .screen-section { padding-top: clamp(8px, 2vw, 24px); }
  .still { display: block; max-width: 100%; height: auto; margin-inline: auto; border-radius: var(--radius); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap); grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .point { margin: 0; padding: 28px 28px 30px; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 4px 16px; align-items: start; align-content: start; }
  .point h3 { font-size: 26px; padding-top: 10px; }
  .point p { grid-column: 2; margin: 0; color: var(--secondary); font-size: 17px; line-height: 1.5; }
  .point a { color: var(--fg); font-weight: 700; }
  @media (max-width: 560px) { .point p { grid-column: 1 / -1; margin-top: 4px; } }
  .icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 18px; color: var(--on-accent); background: var(--yellow); }
  .icon.pink { background: var(--pink); }
  .icon.sky { background: var(--sky); }
  .icon svg { width: 26px; height: 26px; }
  .mac .icon path:nth-child(2) { fill: currentColor; stroke-width: 1.6; }

  /* Each card's icon does the thing its card says, once, when you point at the card. */
  @media (prefers-reduced-motion: no-preference) {
    .note:hover .icon svg { animation: hop 0.7s ease-in-out; }
    .speaker:hover .icon path:nth-child(2) { animation: wave 0.9s ease-in-out; }
    .speaker:hover .icon path:nth-child(3) { animation: wave 0.9s 0.18s ease-in-out; }
    .clock:hover .icon path:nth-child(2) { animation: sweep 1.1s cubic-bezier(0.5, 0, 0.2, 1); transform-origin: 12px 12px; }
    .mac:hover .icon path:nth-child(2) { animation: drop 0.6s cubic-bezier(0.3, 1.5, 0.5, 1); }
    .lock:hover .icon path:nth-child(2) { animation: shackle 0.8s ease-in-out; }
    .heart:hover .icon svg { animation: beat 0.8s ease-in-out; }
    @keyframes hop { 30% { transform: translateY(-5px) rotate(-12deg); } 65% { transform: translateY(0) rotate(8deg); } }
    @keyframes wave { 35% { opacity: 0.1; } 70% { opacity: 1; } }
    @keyframes sweep { to { transform: rotate(360deg); } }
    @keyframes drop { from { transform: translateY(-6px); opacity: 0; } }
    @keyframes shackle { 35% { transform: translateY(-3px); } 70% { transform: translateY(0); } }
    @keyframes beat { 25% { transform: scale(1.25); } 45% { transform: scale(1); } 65% { transform: scale(1.18); } }
  }

  .panel {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 40px 56px;
    padding: clamp(28px, 6vw, 80px); border-radius: clamp(28px, 5vw, 56px);
    background: var(--yellow); color: var(--on-accent);
  }
  .panel { position: relative; padding-top: clamp(56px, 8vw, 104px); }

  /* The notch hangs from the panel's top edge, like the real one. Its bars move as you scroll past, and rest when you stop. */
  .panel-notch {
    position: absolute; top: 0; left: 50%; translate: -50% 0; display: flex; align-items: flex-end; justify-content: center; gap: 5px;
    width: 132px; height: 32px; padding-bottom: 8px; background: var(--notch); border-radius: 0 0 18px 18px;
  }
  .panel-notch i { width: 4px; height: 14px; border-radius: 2px; transform-origin: bottom; background: var(--yellow); }
  .panel-notch i:nth-child(2) { background: var(--pink); }
  .panel-notch i:nth-child(3) { background: var(--sky); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .panel-notch i { animation: dance linear both; animation-timeline: view(); animation-range: entry 0% exit 70%; }
      .panel-notch i:nth-child(even) { animation-name: dance-b; }
      @keyframes dance { 0% { transform: scaleY(0.3); } 14% { transform: scaleY(1); } 29% { transform: scaleY(0.4); } 43% { transform: scaleY(0.85); } 57% { transform: scaleY(0.3); } 71% { transform: scaleY(1); } 86% { transform: scaleY(0.5); } 100% { transform: scaleY(0.8); } }
      @keyframes dance-b { 0% { transform: scaleY(0.9); } 14% { transform: scaleY(0.35); } 29% { transform: scaleY(1); } 43% { transform: scaleY(0.4); } 57% { transform: scaleY(0.95); } 71% { transform: scaleY(0.3); } 86% { transform: scaleY(1); } 100% { transform: scaleY(0.6); } }
    }
  }
  .panel h2 { font-size: clamp(44px, 7vw, 96px); line-height: 0.95; }
  .blurb { margin: 20px 0 24px; max-width: 24em; font-size: clamp(18px, 2vw, 21px); line-height: 1.45; }
  .panel :global(.copy) { max-width: 460px; color: var(--fg); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .panel :global(.for-macs) { margin-top: 18px; }
  .panel .button.quiet { background: #fffbf2; color: #2b2118; }
  .label { margin: 0 0 8px; font: 800 12px/1.4 var(--font); letter-spacing: 0.1em; text-transform: uppercase; }
  .gate { margin: 0 0 16px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: step; }
  .steps li {
    counter-increment: step; display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px; align-items: center;
    padding: 14px 18px 14px 14px; border-radius: 22px; background: rgb(255 251 242 / 0.85); color: #2b2118;
  }
  .steps li::before {
    content: counter(step); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    font: 700 20px/1 var(--display); font-variation-settings: 'SOFT' 100; color: var(--yellow); background: var(--notch);
  }
  .beta { margin: 20px 0 0; font-size: 15px; font-weight: 600; max-width: 34em; }
  .panel a:not(.button) { color: inherit; text-decoration-color: var(--on-accent); }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Sections rise in as they scroll into view, where the browser can tie an animation to scrolling. */
  @supports (animation-timeline: view()) {
    .point, .panel { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 35%; }
    @keyframes rise { from { opacity: 0; transform: translateY(30px); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .squig path { animation: none; }
    .point, .panel { animation: none; }
  }
</style>
