---
import Copy from '../components/Copy.astro';
import ForMacs from '../components/ForMacs.astro';
import NotchDemo from '../components/NotchDemo.astro';
import NotchStill from '../components/NotchStill.astro';
import ScreenCrop from '../components/ScreenCrop.astro';
import Base from '../layouts/Base.astro';
import player from '../../../docs/media/player.png';
import { latestRelease } from '../lib/release';

const release = await latestRelease();
const install = 'curl -fsSL https://warble.lorcanchinnock.com/install.sh | bash';

const tracks = {
  momentApart: { title: 'A Moment Apart', artist: 'ODESZA', album: 'A Moment Apart', art: 'moment-apart', glow: ['31 111 139', '20 64 90'] as [string, string] },
  blindingLights: { title: 'Blinding Lights', artist: 'The Weeknd', album: 'After Hours', art: 'blinding-lights', glow: ['130 105 60', '150 120 70'] as [string, string] },
  nightcall: { title: 'Nightcall', artist: 'Kavinsky', album: 'Nightcall', art: 'nightcall', glow: ['20 90 160', '30 80 150'] as [string, string] },
};
const squiggle = 'M4 14C40 2 70 22 110 12S190 4 230 14 280 8 296 12';
const tick = 'M5 12.5 10 17 19 7';
const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Warble',
  description: "Shows what's playing in your Mac's notch, with play, pause, skip and speaker controls. Free and open source.",
  url: 'https://warble.lorcanchinnock.com/',
  image: 'https://warble.lorcanchinnock.com/icon-256.png',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS 15 or later',
  softwareVersion: release.version,
  downloadUrl: 'https://github.com/LorcanChinnock/warble/releases/latest',
  license: 'https://github.com/LorcanChinnock/warble/blob/main/LICENSE',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Lorcan Chinnock', url: 'https://lorcanchinnock.com' },
  sameAs: ['https://github.com/LorcanChinnock/warble'],
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(software)} />
  <section class="hero">
    <div class="wrap">
      <h1>Your music, in the <span class="squig now">notch<svg aria-hidden="true" viewBox="0 0 300 24" preserveAspectRatio="none"><path d={squiggle} fill="none" stroke="var(--pink)" stroke-width="8" stroke-linecap="round" pathLength="1" /></svg></span>.</h1>
      <p class="lede">Hover over your Mac's notch to see the song, then play, pause, skip or switch speakers. When nothing's playing, it stays out of sight.</p>
      <div class="cta"><Copy command={install} /></div>
      <ForMacs />
      <p class="facts"><span class="free">Free</span>Open source · No account · macOS 15 or later · Apple silicon and Intel</p>
      <p class="version">Version {release.version} · <a href="#install">How to install</a></p>
      <div class="stage">
        <NotchDemo />
        <noscript><img class="still" src={player.src} width={player.width} height={player.height} alt="Warble's opened notch showing the song Paper Lanterns by Juniper Hale, with the position bar, previous, pause and next buttons and the volume slider." /></noscript>
      </div>
    </div>
  </section>

  <section class="chapter rise" id="features" aria-labelledby="see-it">
    <div class="wrap row">
      <div class="text">
        <p class="number"><span>1</span>See it</p>
        <h2 id="see-it">The song is one <span class="squig">hover<svg aria-hidden="true" viewBox="0 0 300 24" preserveAspectRatio="none"><path d={squiggle} fill="none" stroke="var(--pink)" stroke-width="8" stroke-linecap="round" pathLength="1" /></svg></span> away.</h2>
        <p>While music plays, the notch shows the cover and a little meter, and nothing else. Point at it and it opens in a split second. Click it and the app that's playing comes to the front.</p>
        <ul class="players"><li>Apple Music</li><li>Spotify</li><li>Podcasts</li><li>Safari and Chrome</li></ul>
      </div>
      <div class="picture">
        <ScreenCrop height={190} app="Safari" label="The resting notch, with the album cover on its left and a meter on its right, and the pointer moving towards it">
          <NotchStill state="rest" track={tracks.momentApart} pointer={{ x: 70, y: 62 }} />
        </ScreenCrop>
      </div>
    </div>
  </section>

  <section class="chapter rise" aria-labelledby="hear-it">
    <div class="wrap row flip">
      <div class="text">
        <p class="number"><span>2</span>Hear it</p>
        <h2 id="hear-it">Send it to the right <span class="squig">speaker<svg aria-hidden="true" viewBox="0 0 300 24" preserveAspectRatio="none"><path d={squiggle} fill="none" stroke="var(--pink)" stroke-width="8" stroke-linecap="round" pathLength="1" /></svg></span>.</h2>
        <p>Click the symbol at the end of the volume slider and choose your Mac, headphones or AirPods, without opening Control Centre. Each one keeps its own volume.</p>
      </div>
      <div class="picture">
        <ScreenCrop height={330} label="The open notch with the speaker list below it, with MacBook Pro Speakers ticked">
          <NotchStill state="open" track={tracks.blindingLights} played={0.36} elapsed="1:12" remaining="-2:08" speakers />
        </ScreenCrop>
      </div>
    </div>
  </section>

  <section class="chapter rise" aria-labelledby="every-mac">
    <div class="wrap row">
      <div class="text">
        <p class="number"><span>3</span>Every Mac</p>
        <h2 id="every-mac">No notch? Warble draws <span class="squig">one<svg aria-hidden="true" viewBox="0 0 300 24" preserveAspectRatio="none"><path d={squiggle} fill="none" stroke="var(--pink)" stroke-width="8" stroke-linecap="round" pathLength="1" /></svg></span>.</h2>
        <p>On a Mac without a notch, an external display, or with the lid closed, Warble draws a notch of its own at the top of the screen, with the song's title in the middle.</p>
      </div>
      <div class="picture">
        <ScreenCrop height={150} app="Finder" external label="An external display's menu bar with the notch Warble draws, showing the title Nightcall">
          <NotchStill state="drawn" track={tracks.nightcall} />
        </ScreenCrop>
      </div>
    </div>
  </section>

  <section class="chapter rise" aria-labelledby="calm">
    <div class="wrap row flip">
      <div class="text">
        <p class="number"><span>4</span>Calm</p>
        <h2 id="calm">Nothing playing, nothing <span class="squig">running<svg aria-hidden="true" viewBox="0 0 300 24" preserveAspectRatio="none"><path d={squiggle} fill="none" stroke="var(--pink)" stroke-width="8" stroke-linecap="round" pathLength="1" /></svg></span>.</h2>
        <p>When the music stops, Warble draws nothing and uses no CPU. Point at an empty notch and a one-line note says so, so it never feels broken.</p>
      </div>
      <div class="picture">
        <ScreenCrop height={190} app="Finder" label="An empty notch opened to a one-line note that reads Nothing playing">
          <NotchStill state="note" pointer={{ x: 36, y: 50 }} />
        </ScreenCrop>
      </div>
    </div>
  </section>

  <section class="privacy-section rise" aria-labelledby="privacy-title">
    <div class="wrap">
      <div class="privacy">
        <div class="intro">
          <h2 id="privacy-title">Your music stays yours.</h2>
          <p>No account, no cloud, no analytics. The <a href="https://github.com/LorcanChinnock/warble">code is on GitHub</a> for anyone to check.</p>
        </div>
        <ul>
          <li><span class="tick"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tick} /></svg></span><div><b>Nothing to sign in to</b><span>Warble has no account and sends no analytics.</span></div></li>
          <li><span class="tick"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tick} /></svg></span><div><b>Updates when you agree</b><span>It asks before it checks for a new version.</span></div></li>
          <li><span class="tick"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tick} /></svg></span><div><b>Covers, with the least it can send</b><span>For a song in your browser, only its title and artist go to Apple's iTunes Search. A click on the artist asks Spotify or YouTube for their page.</span></div></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="faq rise" id="faq" aria-labelledby="faq-title">
    <div class="narrow">
      <h2 id="faq-title">Questions, <span class="squig">answered<svg aria-hidden="true" viewBox="0 0 300 24" preserveAspectRatio="none"><path d={squiggle} fill="none" stroke="var(--pink)" stroke-width="8" stroke-linecap="round" pathLength="1" /></svg></span>.</h2>
      <details name="faq" open>
        <summary>Is Warble really free?</summary>
        <p>Yes. It's open source under the GPL-3.0 license, with no ads. Warble updates itself, and a dot on its menu bar icon shows when a new version is ready. If you like it, you can <a href="/sponsor">sponsor it</a>, which keeps it free.</p>
      </details>
      <details name="faq" id="gatekeeper">
        <summary>Why does macOS warn me when I open it?</summary>
        <p>Apple hasn't notarized Warble. The install command avoids the warning, since macOS doesn't check apps that Terminal downloads. If you downloaded the zip, allow it once:</p>
        <ol>
          <li>Open Warble from Applications. macOS says it can't check Warble. Click <b>Done</b>.</li>
          <li>Open <b>System Settings</b>, choose <b>Privacy &amp; Security</b> and scroll down to <b>Security</b>.</li>
          <li>Click <b>Open Anyway</b> next to the message about Warble, then confirm.</li>
        </ol>
      </details>
      <details name="faq">
        <summary>Which players does it work with?</summary>
        <p>Apple Music, Spotify, podcast apps, and video in Safari, Chrome or any other browser. For Apple Music, Settings can add a heart that saves the song to your Favourites.</p>
      </details>
      <details name="faq">
        <summary>Does it work on a Mac without a notch?</summary>
        <p>Yes. Warble draws a notch of its own on a Mac without one, on an external display, or with the lid closed. <a href="/docs/external-displays/">External displays</a> has the details.</p>
      </details>
      <details name="faq">
        <summary>How do I remove it?</summary>
        <p>Paste the uninstall command from <a href="/docs/remove-warble/">Remove Warble</a> into Terminal. It quits Warble and moves it to the Trash.</p>
      </details>
    </div>
  </section>

  <section class="install-section" id="install" aria-labelledby="install-title">
    <div class="wrap">
      <div class="panel rise">
        <div class="panel-notch" aria-hidden="true"><NotchStill state="rest" track={tracks.momentApart} /></div>
        <h2 id="install-title">Play something.</h2>
        <p class="blurb">Paste this into Terminal. It downloads the latest release, checks it against the release's checksum and copies Warble into Applications.</p>
        <Copy command={install} />
        <ForMacs />
        <p class="after">Warble opens by itself. Play a song and the notch slides out. <a href="/docs/get-started/">Get started</a> covers the rest. Warble is a beta, so expect changes between versions. If you downloaded the zip, <a href="#gatekeeper">allow it once</a>.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // A link to a closed FAQ answer, such as the install panel's to #gatekeeper, opens it; not every browser does that itself.
  const openTarget = () => {
    const target = location.hash && document.querySelector(location.hash);
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  addEventListener('hashchange', openTarget);
  openTarget();
</script>

<style>
  .hero { padding-top: clamp(24px, 5vw, 56px); padding-bottom: 0; }
  .hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
  h1 { max-width: 15ch; font-size: var(--h1-hero); font-weight: 800; line-height: 0.98; letter-spacing: -0.035em; }
  .lede { max-width: 600px; margin: 22px 0 0; font-size: var(--lede); line-height: 1.5; color: var(--secondary); }
  .cta { display: flex; justify-content: center; width: 100%; margin-top: 30px; }
  .cta :global(.copy) { flex: 0 1 auto; min-width: 0; text-align: start; }
  .hero :global(.for-macs) { justify-content: center; margin-top: 18px; }
  .facts {
    display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 8px;
    margin: 18px 0 0; padding: 5px 12px 5px 5px; border-radius: 999px; background: var(--fill);
    font-size: 13.5px; color: var(--secondary);
  }
  @media (max-width: 520px) {
    .facts { border-radius: 18px; padding: 8px 14px; }
  }
  .free { padding: 1px 9px; border-radius: 999px; font-weight: 700; color: var(--on-accent); background: var(--yellow); }
  .version { margin: 14px 0 0; font-size: 13px; color: var(--secondary); }
  .stage { width: 100%; max-width: 980px; margin-top: 48px; }
  .still { display: block; max-width: 100%; height: auto; margin-inline: auto; border-radius: var(--radius); }

  .chapter { padding-block: clamp(44px, 6vw, 88px) 0; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 56px; }
  .row.flip { flex-direction: row-reverse; }
  .text { flex: 1 1 360px; min-width: 0; }
  .picture { flex: 1.2 1 440px; min-width: 0; }
  .number { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; font-size: 14px; font-weight: 700; color: var(--secondary); }
  .number span {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%;
    font: 800 16px/1 var(--display); font-variation-settings: 'SOFT' 100; color: var(--on-accent); background: var(--yellow);
  }
  h2 { font-size: var(--h2); font-weight: 800; line-height: 1.04; letter-spacing: -0.025em; }
  .text p { max-width: 460px; margin: 16px 0 0; font-size: 18px; color: var(--secondary); }
  .players { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
  .players li { padding: 5px 12px; border-radius: 999px; font-size: 14px; font-weight: 600; background: var(--surface); box-shadow: var(--lift); }

  .privacy-section { padding-block: clamp(64px, 8vw, 96px) 0; }
  .privacy {
    display: flex; flex-wrap: wrap; align-items: center; gap: 32px 40px; padding: clamp(28px, 5vw, 56px);
    border-radius: 30px; color: var(--on-cmd); background: var(--cmd);
  }
  .privacy .intro { flex: 1 1 340px; }
  .privacy h2 { color: var(--on-cmd); }
  .privacy p { max-width: 440px; margin: 16px 0 0; font-size: 18px; color: color-mix(in srgb, var(--on-cmd) 82%, var(--cmd)); }
  .privacy a { text-decoration-color: var(--pink); }
  .privacy ul { flex: 1 1 380px; display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .privacy li { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: 18px; background: rgb(255 244 220 / 0.07); }
  .privacy li b { display: block; font-size: 16px; }
  .privacy li span:not(.tick) { font-size: 14.5px; color: color-mix(in srgb, var(--on-cmd) 82%, var(--cmd)); }
  .tick { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; background: var(--yellow); }
  .tick svg { width: 13px; height: 13px; fill: none; stroke: var(--on-accent); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }

  .faq { padding-block: clamp(64px, 8vw, 104px) 0; }
  .faq h2 { text-align: center; margin-bottom: 28px; }
  details { margin: 0 0 10px; padding: 0 22px; border-radius: 18px; background: var(--surface); box-shadow: var(--lift); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 16px 0;
    font-weight: 700; font-size: 17px; list-style: none; cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px;
    font-size: 18px; line-height: 1; background: var(--fill);
  }
  details[open] summary::after { content: '−'; }
  details p, details ol { margin: 0 0 18px; font-size: 16px; color: var(--secondary); }
  details ol { padding-left: 20px; display: grid; gap: 6px; }

  .install-section { padding-block: clamp(64px, 8vw, 104px) 0; }
  .panel {
    position: relative; overflow: hidden; display: grid; justify-items: center; text-align: center;
    padding: clamp(80px, 9vw, 104px) clamp(20px, 4vw, 32px) clamp(44px, 6vw, 64px);
    border-radius: 34px; color: var(--on-accent); background: var(--yellow);
  }
  .panel-notch { position: absolute; inset: 0 0 auto; height: 37px; }
  .panel h2 { font-size: clamp(48px, 6vw, 80px); color: var(--on-accent); }
  .blurb { max-width: 540px; margin: 14px 0 26px; font-size: 18px; }
  .panel :global(.copy) { max-width: 100%; }
  .panel :global(.for-macs) { justify-content: center; margin-top: 18px; }
  .after { max-width: 560px; margin: 22px 0 0; font-size: 14.5px; }
  .panel a { color: inherit; text-decoration-color: var(--on-accent); }
</style>
