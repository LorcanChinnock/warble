---
import Base from '../layouts/Base.astro';
import NotchStill from '../components/NotchStill.astro';
import ScreenCrop from '../components/ScreenCrop.astro';
---

<Base title="Not found" noindex>
  <section class="lost">
    <div class="narrow">
      <ScreenCrop height={170} app="Finder" label="An empty notch opened to a one-line note that reads Nothing playing">
        <NotchStill state="note" />
      </ScreenCrop>
      <h1>Page not found</h1>
      <p class="sub">Nothing playing here. The page may have moved, or the link may be wrong.</p>
      <p class="links"><a class="button big" href="/">Back to the home page</a></p>
      <p class="guide">Or open the <a href="/docs/get-started/">user guide</a>.</p>
    </div>
  </section>
</Base>

<style>
  .lost { padding-block: clamp(24px, 4vw, 48px) 0; }
  .lost .narrow { display: grid; justify-items: center; text-align: center; }
  .lost :global(.crop) { width: min(100%, 560px); }
  h1 { margin-top: 8px; font-size: clamp(44px, 6vw, 72px); font-weight: 800; line-height: 1; letter-spacing: -0.03em; }
  .sub { max-width: 30em; margin: 18px 0 30px; font-size: var(--lede); line-height: 1.5; color: var(--secondary); }
  .links { margin: 0; }
  .guide { margin: 18px 0 0; font-size: 15px; color: var(--secondary); }
</style>
