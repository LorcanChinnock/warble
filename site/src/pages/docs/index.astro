---
import GuideSearch from '../../components/GuideSearch.astro';
import Prose from '../../layouts/Prose.astro';
import { groups, pages } from '../../lib/guide';

const [start] = pages;
const sections = groups
  .map((g) => ({ ...g, pages: pages.filter((p) => p.group === g.name && p !== start) }))
  .filter((g) => g.pages.length > 0);
---

<Prose title="User guide" description="How to use Warble: playback controls, displays and settings.">
  <div class="guide-home">
    <h1>How can we help?</h1>
    <p class="lede">Everything Warble can do, one task at a time. Search for what you need, or start at the top.</p>
    <GuideSearch />

    <a class="start card notch" href={`/docs/${start.slug}/`}>
      <span class="new">New to Warble?</span>
      <strong>{start.title} →</strong>
      <span>{start.summary}</span>
    </a>

    {sections.map((section) => (
      <section>
        <h2>{section.name}</h2>
        <ul>
          {section.pages.map((page) => (
            <li>
              <a class="card" href={`/docs/${page.slug}/`}>
                <strong>{page.title}</strong>
                <span>{page.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Prose>

<style>
  .guide-home h1 { margin-bottom: 12px; }
  .lede { margin: 0 0 24px; font-size: 20px; line-height: 1.45; color: var(--secondary); }
  .guide-home :global(.guide-search) { margin-bottom: 28px; }
  /* The way in is drawn as the notch's open card: black, with the glow rising from its bottom corners. */
  .start {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; gap: 6px; justify-items: start; padding: 22px 24px; text-decoration: none;
    border-radius: 8px 8px var(--radius-card) var(--radius-card);
  }
  .start::before, .start::after { content: ""; position: absolute; z-index: -1; bottom: -60%; width: 80%; height: 160%; opacity: 0.5; transition: opacity 200ms ease-out; }
  .start::before { left: -30%; background: radial-gradient(closest-side, var(--glow-a), transparent); }
  .start::after { right: -30%; background: radial-gradient(closest-side, var(--glow-b), transparent); }
  .start:hover::before, .start:hover::after { opacity: 0.65; }
  .start .new { font-size: 13px; color: var(--on-notch-secondary); }
  .start strong { font: 700 24px/1.15 var(--display); letter-spacing: -0.02em; }
  .start span:last-child { font-size: 16px; color: var(--on-notch-secondary); }
  section { padding: 0; margin-top: 40px; }
  .guide-home section h2 { margin: 0 0 12px; padding: 0; border: 0; font-size: 13px; font-family: var(--font); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--secondary); }
  ul { list-style: none; margin: 0; padding: 0 !important; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  li { margin: 0 !important; display: grid; }
  ul .card { display: grid; align-content: start; gap: 4px; padding: 14px 16px; text-decoration: none; transition: border-color 120ms ease-out; }
  ul .card:hover { border-color: var(--hairline-strong); }
  ul .card strong { font-size: 17px; font-weight: 600; }
  ul .card span { font-size: 15px; line-height: 1.45; color: var(--secondary); }
</style>
