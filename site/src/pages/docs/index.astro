---
import GuideSearch from '../../components/GuideSearch.astro';
import Prose from '../../layouts/Prose.astro';
import { groups, pages } from '../../lib/guide';

const [start] = pages;
const sections = groups
  .map((g) => ({ ...g, pages: pages.filter((p) => p.group === g.name && p !== start) }))
  .filter((g) => g.pages.length > 0);
---

<Prose title="User guide" description="How to use Warble: playback controls, displays and settings.">
  <div class="guide-home">
    <h1>How can we help?</h1>
    <p class="lede">Everything Warble can do, one task at a time. Search for what you need, or start at the top.</p>
    <GuideSearch />

    <a class="start" href={`/docs/${start.slug}/`}>
      <span class="new">New to Warble?</span>
      <strong>{start.title} →</strong>
      <span class="summary">{start.summary}</span>
    </a>

    {sections.map((section) => (
      <section>
        <h2>{section.name}</h2>
        <ul>
          {section.pages.map((page) => (
            <li>
              <a class="card" href={`/docs/${page.slug}/`}>
                <strong>{page.title}</strong>
                <span>{page.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Prose>

<style>
  .guide-home h1 { margin-bottom: 14px; }
  .lede { margin: 0 0 28px; font-size: clamp(19px, 2.1vw, 23px); line-height: 1.45; color: var(--secondary); }
  .guide-home :global(.guide-search) { margin-bottom: 32px; }
  .start {
    display: grid; gap: 6px; justify-items: start; padding: 28px 30px; text-decoration: none;
    border-radius: var(--radius); background: var(--yellow); color: var(--on-accent);
    box-shadow: 0 6px 0 var(--yellow-deep); transition: transform 150ms ease-out, box-shadow 150ms ease-out;
  }
  .start:hover { transform: translateY(-3px); box-shadow: 0 9px 0 var(--yellow-deep); }
  .start .new { font: 800 12px/1.4 var(--font); letter-spacing: 0.1em; text-transform: uppercase; }
  .start strong { font: 700 clamp(28px, 4vw, 40px)/1.05 var(--display); font-variation-settings: 'SOFT' 100; letter-spacing: -0.03em; }
  .start .summary { font-size: 18px; font-weight: 600; }
  section { padding: 0; margin-top: 44px; }
  .guide-home section h2 { margin: 0 0 14px; font: 800 12px/1.4 var(--font); letter-spacing: 0.1em; text-transform: uppercase; color: var(--secondary); }
  ul { list-style: none; margin: 0; padding: 0 !important; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  ul > li { margin: 0 !important; padding: 0 !important; display: grid; }
  ul > li::before { display: none !important; }
  ul .card { display: grid; align-content: start; gap: 6px; padding: 20px 22px; text-decoration: none; transition: transform 150ms ease-out; }
  ul .card:hover { transform: translateY(-3px); }
  ul .card strong { font: 700 22px/1.15 var(--display); font-variation-settings: 'SOFT' 100; letter-spacing: -0.02em; }
  ul .card span { font-size: 15px; line-height: 1.45; font-weight: 500; color: var(--secondary); }
  @media (prefers-reduced-motion: reduce) { .start, ul .card { transition: none; } .start:hover, ul .card:hover { transform: none; } }
</style>
