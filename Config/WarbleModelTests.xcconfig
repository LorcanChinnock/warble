// WarbleModel's unit tests (Swift Testing). The linux check runs them through Package.swift too. They need no window, so they run without a host
// app or a signing certificate.
PRODUCT_NAME = WarbleModelTests
PRODUCT_BUNDLE_IDENTIFIER = dev.lorcan.Warble.WarbleModelTests
GENERATE_INFOPLIST_FILE = YES
CODE_SIGN_IDENTITY = -

// Your own overrides, such as CODE_SIGN_IDENTITY. Git ignores this file.
#include? "Local.xcconfig"
