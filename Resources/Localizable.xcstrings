      }
    },
    "macOS asks once for each browser. Works with Safari, Chrome, Brave, Edge, Arc and Vivaldi. Without it, or in another browser, the button opens the browser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS fragt einmal pro Browser. Funktioniert mit Safari, Chrome, Brave, Edge, Arc und Vivaldi. Ohne das, oder in einem anderen Browser, öffnet die Taste den Browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS pregunta una vez por cada navegador. Funciona con Safari, Chrome, Brave, Edge, Arc y Vivaldi. Sin esto, o en otro navegador, el botón abre el navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demande une fois pour chaque navigateur. Fonctionne avec Safari, Chrome, Brave, Edge, Arc et Vivaldi. Sans cela, ou dans un autre navigateur, le bouton ouvre le navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lo chiede una volta per ogni browser. Funziona con Safari, Chrome, Brave, Edge, Arc e Vivaldi. Senza, o con un altro browser, il pulsante apre il browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSはブラウザごとに一度だけ確認します。Safari、Chrome、Brave、Edge、Arc、Vivaldiで使えます。許可しない場合やほかのブラウザでは、ボタンはブラウザを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 브라우저마다 한 번씩 묻습니다. Safari, Chrome, Brave, Edge, Arc, Vivaldi에서 작동합니다. 허용하지 않거나 다른 브라우저에서는 버튼이 브라우저를 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS pergunta uma vez para cada navegador. Funciona com Safari, Chrome, Brave, Edge, Arc e Vivaldi. Sem isso, ou em outro navegador, o botão abre o navegador."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会为每个浏览器询问一次。适用于 Safari、Chrome、Brave、Edge、Arc 和 Vivaldi。未允许或使用其他浏览器时，该按钮会打开浏览器。"
          }
        }
      }
    },
    "macOS didn't let Warble hear your Mac's audio. Allow Warble in System Settings › Privacy & Security › Screen & System Audio Recording, then turn this on again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat Warble nicht erlaubt, den Ton deines Mac zu hören. Erlaube Warble unter Systemeinstellungen › Datenschutz & Sicherheit › Bildschirm- & Systemaudioaufnahme und schalte dies dann erneut ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no permitió que Warble oyera el audio de tu Mac. Permite a Warble en Ajustes del Sistema › Privacidad y seguridad › Grabación de pantalla y audio del sistema y vuelve a activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas autorisé Warble à écouter le son de votre Mac. Autorisez Warble dans Réglages Système › Confidentialité et sécurité › Enregistrement de l’écran et de l’audio système, puis réactivez cette option."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha permesso a Warble di ascoltare l'audio del Mac. Consenti Warble in Impostazioni di Sistema › Privacy e sicurezza › Registrazione schermo e audio di sistema, poi riattiva questa opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがWarbleにMacのオーディオを聞くことを許可しませんでした。システム設定 › プライバシーとセキュリティ › 画面収録とシステムオーディオ収録でWarbleを許可してから、もう一度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 Warble이 Mac의 오디오를 듣도록 허용하지 않았습니다. 시스템 설정 › 개인정보 보호 및 보안 › 화면 및 시스템 오디오 녹음에서 Warble을 허용한 다음 이 기능을 다시 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não deixou o Warble ouvir o áudio do Mac. Permita o Warble em Ajustes do Sistema › Privacidade e Segurança › Gravação de Tela e Áudio do Sistema e ative isto de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未允许 Warble 听取 Mac 的音频。请在“系统设置” › “隐私与安全性” › “屏幕与系统音频录制”中允许 Warble，然后再次开启此项。"
          }
        }
      }
    },
    "macOS will ask the first time %@ plays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS fragt beim ersten Abspielen von „%@“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS preguntará la primera vez que suene %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demandera la première fois que %@ jouera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lo chiederà la prima volta che %@ riproduce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が最初に再生するときに、macOSが確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 처음 재생될 때 macOS에서 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS vai perguntar na primeira vez que %@ tocar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 首次播放时，macOS 会询问。"
          }
        }
      }
    },
    "macOS won't let Warble read what's playing, so it only follows Music and Spotify." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erlaubt Warble nicht, die Wiedergabe auszulesen, daher folgt es nur Music und Spotify."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no deja que Warble lea lo que suena, así que solo sigue Música y Spotify."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne permet pas à Warble de lire ce qui joue : il ne suit donc que Music et Spotify."
          }
        },
        "it" : {
          "stringUnit" : {
