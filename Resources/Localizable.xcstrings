        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora solo se pueden mostrar Música y Spotify."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls Music et Spotify peuvent s’afficher pour l’instant."
          }
