    "The updater didn't start. Install the latest Warble from the website to get updates again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktualisierung ist nicht gestartet. Installiere das neueste Warble von der Website, um wieder Updates zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El actualizador no se inició. Instala la última versión de Warble desde el sitio web para volver a recibir actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme de mise à jour n’a pas démarré. Installez le dernier Warble depuis le site web pour recevoir à nouveau les mises à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di aggiornamento non è partito. Installa l’ultima versione di Warble dal sito web per ricevere di nuovo gli aggiornamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデータが起動しませんでした。Webサイトから最新のWarbleをインストールすると、再びアップデートを受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 도구가 시작되지 않았습니다. 웹사이트에서 최신 Warble을 설치하면 다시 업데이트를 받을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
