    "Warble opens when you log in, so the notch is there after a restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble öffnet sich bei der Anmeldung, damit die Notch nach einem Neustart da ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble se abre al iniciar sesión, así que el notch está ahí tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble s’ouvre à la connexion, pour que le notch soit là après un redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble si apre al login, così il notch c'è dopo un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時にWarbleが開くので、再起動後もノッチが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인할 때 Warble이 열리므로 재시작 후에도 노치가 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
