    "Swipe left with two fingers for the next song, or right to go back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische mit zwei Fingern nach links für den nächsten Song oder nach rechts zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda con dos dedos para la canción siguiente, o a la derecha para volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche avec deux doigts pour le morceau suivant, ou vers la droite pour revenir en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a sinistra con due dita per il brano successivo, o a destra per tornare indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本指で左にスワイプすると次の曲、右にスワイプすると前の曲です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 손가락으로 왼쪽으로 쓸어넘기면 다음 곡, 오른쪽으로 쓸어넘기면 이전 곡입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda com dois dedos para a próxima música, ou para a direita para voltar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用两根手指向左轻扫切到下一首，向右轻扫返回上一首。"
          }
        }
      }
    },
    "Swipe over the notch to skip" : {
