    "Only the message shows. The notch stays out of the way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Meldung erscheint. Die Notch bleibt aus dem Weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestra el aviso. El notch no estorba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le message s’affiche. Le notch reste discret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare solo il messaggio. Il notch resta fuori dai piedi."
          }
        },
        "ja" : {
