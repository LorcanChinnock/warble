        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지한 시간이 아닌 실제로 들은 시간입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
