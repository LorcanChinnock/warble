            "value" : "Wie lange ein pausierter Song zu sehen bleibt, bevor die Notch zur Ruhe kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo sigue visible una canción en pausa antes de que el notch se quede en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps un morceau en pause reste affiché avant que l’encoche ne se calme."
          }
        },
