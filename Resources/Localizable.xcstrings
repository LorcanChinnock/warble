    "Add ⌘, ⌥ or ⌃, so the shortcut doesn't catch your typing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ⌘, ⌥ oder ⌃ hinzu, damit der Kurzbefehl nicht beim Tippen auslöst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade ⌘, ⌥ o ⌃ para que el atajo no capture lo que escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez ⌘, ⌥ ou ⌃ pour que le raccourci ne se déclenche pas quand vous tapez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi ⌘, ⌥ o ⌃, così la scorciatoia non intercetta ciò che scrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘、⌥、⌃のいずれかを加えて、入力中の文字に反応しないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘, ⌥ 또는 ⌃ 키를 함께 사용하세요. 그러면 입력 중에 단축키가 실행되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione ⌘, ⌥ ou ⌃ para que o atalho não capture o que você digita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请加上 ⌘、⌥ 或 ⌃，这样快捷键就不会拦截你的输入。"
          }
        }
      }
    },
