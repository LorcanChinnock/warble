    "%@ is used by macOS and every app. Try another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von macOS und allen Apps verwendet. Wähle eine andere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS y todas las apps usan %@. Prueba con otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est utilisé par macOS et toutes les apps. Essayez-en un autre."
