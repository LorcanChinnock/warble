    "You have %@. The download is %@, and Warble quits and reopens to finish, which takes a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@. Der Download ist %2$@ groß, und Warble wird beendet und wieder geöffnet, um fertig zu werden. Das dauert ein paar Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have %1$@. The download is %2$@, and Warble quits and reopens to finish, which takes a few seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la %1$@. La descarga ocupa %2$@, y Warble se cierra y se vuelve a abrir para terminar, lo que tarda unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez la %1$@. Le téléchargement fait %2$@, et Warble se ferme et se rouvre pour terminer, ce qui prend quelques secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai la %1$@. Il download è di %2$@ e Warble si chiude e si riapre per completare, il che richiede pochi secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のバージョンは%1$@です。ダウンロードは%2$@で、完了するためにWarbleが終了して再び開きます。数秒で終わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 버전은 %1$@입니다. 다운로드 크기는 %2$@이며, 마무리하기 위해 Warble이 종료된 후 다시 열립니다. 몇 초면 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem a %1$@. O download tem %2$@, e o Warble fecha e abre de novo para terminar, o que leva alguns segundos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你当前的版本是 %1$@。下载大小为 %2$@，Warble 会退出并重新打开以完成更新，只需几秒钟。"
          }
        }
      }
    },
