    "While Music plays, a heart beside the title adds the song to your Favourites." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während Musik spielt, fügt ein Herz neben dem Titel den Song deinen Favoriten hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras Música reproduce, un corazón junto al título añade la canción a tus Favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la lecture dans Musique, un cœur à côté du titre ajoute le morceau à vos favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre Musica è in riproduzione, un cuore accanto al titolo aggiunge il brano ai tuoi Preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ミュージック”の再生中、タイトル横のハートで曲をお気に入りに追加できます。"
