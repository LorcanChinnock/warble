    "Part of Warble is missing, so it can only follow Music and Spotify." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil von Warble fehlt, daher kann es nur Music und Spotify folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta una parte de Warble, así que solo puede seguir Música y Spotify."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie de Warble est manquante : il ne peut suivre que Music et Spotify."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca una parte di Warble, quindi può seguire solo Music e Spotify."
