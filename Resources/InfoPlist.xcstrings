{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Asked the first time Warble scripts Music or Spotify.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble zeigt, was Music und Spotify abspielen, und lässt dich beides über die Notch steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble shows what Music and Spotify are playing and lets you control them from the notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble muestra lo que reproducen Música y Spotify y te deja controlarlos desde el notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble affiche ce que Music et Spotify lisent et vous laisse les contrôler depuis le notch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble mostra cosa stanno riproducendo Music e Spotify e ti permette di controllarli dal notch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warbleは、MusicとSpotifyで再生中の曲を表示し、ノッチから操作できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble은 Music과 Spotify에서 재생 중인 곡을 표시하고 노치에서 제어할 수 있게 해 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Warble mostra o que o Music e o Spotify estão tocando e permite controlá-los pelo notch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warble 会显示“音乐”和 Spotify 正在播放的内容，并让你从刘海控制它们。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
